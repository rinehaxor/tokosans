# === DIGIFLAZZ CREDENTIALS ===
# Untuk cek saldo: hanya butuh DIGIFLAZZ_USERNAME
# Untuk topup lengkap: butuh semua berikut:
| DIGIFLAZZ_USERNAME=your-digiflazz-username
| DIGIFLAZZ_API_KEY=your-digiflazz-api-key
| DIGIFLAZZ_MERCHANT_ID=your-digiflazz-merchant-id
| DIGIFLAZZ_WEBHOOK_TOKEN=buat-token-acak-panjang-untuk-callback

# Catatan:
# - Signature dibuat dengan md5(username + apiKey + "depo") untuk cek saldo
# - Signature dibuat dengan md5(merchant + key + ref_id) untuk topup
# - Bisa pakai Development Key untuk testing, tapi perlu whitelist IP di dashboard
# Digiflazz Topup API
| DIGIFLAZZ_MERCHANT_ID=your-digiflazz-merchant-id
| DIGIFLAZZ_API_KEY=your-digiflazz-api-key
| DIGIFLAZZ_USERNAME=your-digiflazz-username
| DIGIFLAZZ_WEBHOOK_TOKEN=buat-token-acak-panjang-untuk-callback
# Digiflazz Topup API
| DIGIFLAZZ_MERCHANT_ID=your-digiflazz-merchant-id
| DIGIFLAZZ_API_KEY=your-digiflazz-api-key
| DIGIFLAZZ_WEBHOOK_TOKEN=buat-token-acak-panjang-untuk-callback

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TOKOPAY_MERCHANT_ID=your-merchant-id
TOKOPAY_SECRET_KEY=your-secret-key
# Isi dengan kode QRIS Realtime dari dashboard/dokumentasi Tokopay Anda.
TOKOPAY_PAYMENT_METHOD=QRIS
TOKOPAY_WEBHOOK_TOKEN=buat-token-acak-panjang-untuk-callback
PUBLIC_SITE_URL=https://tokosans.id

# Nomor WhatsApp admin untuk notifikasi penjualan (format internasional tanpa "+", contoh: 6281234567890)


# Nomor WhatsApp admin yang berwenang mengirim perintah stok (tambah/ambil) ke nomor WA
# yang login di web ini. Pisahkan beberapa nomor dengan koma (format internasional tanpa "+").
# Bila kosong, otomatis memakai ADMIN_WA_NUMBER di atas.


# Ambang batas stok menipis — kirim notifikasi WA ke admin saat sisa akun ≤ nilai ini (default: 2)
STOCK_LOW_THRESHOLD=2