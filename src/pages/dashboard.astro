---
import { formatRupiah } from '../lib/catalog';
import { getProducts } from '../lib/products';
import { getSupabaseAdmin } from '../lib/supabase';
import ToastProvider from '../components/ToastProvider';
import AdminSidebar from '../components/AdminSidebar.astro';

const products = await getProducts();

type Stock = { product_id: string; stock: number; price: number; active: boolean; image_url?: string | null };
type AccountStock = { product_id: string; status: 'available' | 'sold' | 'disabled' };
type Order = { id: string; order_number: string; customer_name: string; customer_email: string; total_amount: number; status: string; created_at: string };
type OrderItem = { id: string; order_id: string; product_id: string; product_name: string; price: number; quantity: number };

let inventory: Stock[] = [];
let accountInventory: AccountStock[] = [];
let orders: Order[] = [];
let paidOrderItems: OrderItem[] = [];
let connected = true;

let dailyRevenue = 0;
let weeklyRevenue = 0;
let monthlyRevenue = 0;
let totalRevenue = 0;

try {
  const db = getSupabaseAdmin();
  const fifteenMinsAgo = new Date(Date.now() - 15 * 60 * 1000).toISOString();
  await Promise.all([
    db.from('orders').update({ status: 'cancelled' }).eq('status', 'pending').lt('created_at', fifteenMinsAgo),
    db.from('payments').update({ status: 'cancelled', qr_string: null, qr_image_url: null }).eq('status', 'pending').lt('created_at', fifteenMinsAgo)
  ]).catch(() => {});

  const [stockResult, accountResult, ordersResult] = await Promise.all([
    db.from('inventory').select('product_id,stock,price,active,image_url'),
    db.from('account_inventory').select('product_id,status'),
    db.from('orders').select('id,order_number,customer_name,customer_email,total_amount,status,created_at').order('created_at', { ascending: false }).limit(500)
  ]);

  if (stockResult.error || accountResult.error || ordersResult.error) {
    throw stockResult.error ?? accountResult.error ?? ordersResult.error;
  }

  inventory = (stockResult.data ?? []) as Stock[];
  accountInventory = (accountResult.data ?? []) as AccountStock[];
  orders = (ordersResult.data ?? []) as Order[];

  const paidOrders = orders.filter((o) => o.status === 'paid');
  const paidOrderIds = paidOrders.map((o) => o.id);

  if (paidOrderIds.length > 0) {
    const itemsResult = await db
      .from('order_items')
      .select('id,order_id,product_id,product_name,price,quantity')
      .in('order_id', paidOrderIds);
    if (!itemsResult.error && itemsResult.data) {
      paidOrderItems = itemsResult.data as OrderItem[];
    }
  }

  const now = new Date();
  const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
  
  // Start of current week (Monday)
  const currentDay = now.getDay();
  const distanceToMonday = (currentDay + 6) % 7;
  const weekStart = new Date(now.getFullYear(), now.getMonth(), now.getDate() - distanceToMonday).getTime();
  
  // Start of current month
  const monthStart = new Date(now.getFullYear(), now.getMonth(), 1).getTime();

  for (const o of paidOrders) {
    const amount = o.total_amount || 0;
    const orderTime = new Date(o.created_at).getTime();

    totalRevenue += amount;
    if (orderTime >= todayStart) {
      dailyRevenue += amount;
    }
    if (orderTime >= weekStart) {
      weeklyRevenue += amount;
    }
    if (orderTime >= monthStart) {
      monthlyRevenue += amount;
    }
  }
} catch (error) {
  connected = false;
  console.error('Admin dashboard error:', error);
}

const stockFor = (id: string) => inventory.find((item) => item.product_id === id);
const accountStockFor = (id: string) => {
  const accounts = accountInventory.filter((account) => account.product_id === id);
  return accounts.length ? accounts.filter((account) => account.status === 'available').length : null;
};
const quantityFor = (id: string) => accountStockFor(id) ?? stockFor(id)?.stock ?? 0;
const isProductActive = (p: (typeof products)[0]) => p.active !== false;

// Low stock list: Active products with quantity < 3
const lowStockProducts = products
  .filter(isProductActive)
  .map((p) => {
    const qty = quantityFor(p.id);
    const isAccountBased = accountStockFor(p.id) !== null;
    return { ...p, currentQty: qty, isAccountBased };
  })
  .filter((p) => p.currentQty < 3)
  .sort((a, b) => a.currentQty - b.currentQty);

const lowStockCount = lowStockProducts.length;

// Variables used by existing metric cards (kept for backwards compat)
const activeCount = products.filter(isProductActive).length;
const lowStock = products.filter(isProductActive).filter((p) => quantityFor(p.id) <= 5).length;

// Top Selling Products Calculation
const productSalesMap = new Map<string, { product_id: string; product_name: string; totalQty: number; totalRevenue: number }>();

for (const item of paidOrderItems) {
  // Normalize base product ID (strip tier suffix if needed)
  const baseId = item.product_id.split('-')[0];
  const matchedProduct = products.find((p) => p.id === baseId || p.id === item.product_id);
  const displayName = matchedProduct ? matchedProduct.name : item.product_name.split('·')[0].trim();
  const prodId = matchedProduct ? matchedProduct.id : baseId;

  const existing = productSalesMap.get(prodId);
  const qty = item.quantity || 1;
  const revenue = (item.price || 0) * qty;

  if (existing) {
    existing.totalQty += qty;
    existing.totalRevenue += revenue;
  } else {
    productSalesMap.set(prodId, {
      product_id: prodId,
      product_name: displayName,
      totalQty: qty,
      totalRevenue: revenue,
    });
  }
}

const topSellingProducts = Array.from(productSalesMap.values())
  .sort((a, b) => b.totalQty - a.totalQty || b.totalRevenue - a.totalRevenue)
  .slice(0, 5);
---

<ToastProvider client:load />
<html lang="id">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Dashboard - TokoSans</title>
    <style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');
:root{--ink:#191026;--muted:#6b6178;--v:#7048e8;--v2:#5c35d4;--l:#f3edff;--line:#eae3f5;--bg:#faf8fe;--surface:#fff;--green:#10b981;--green-bg:#ecfdf5;--yellow:#f59e0b;--yellow-bg:#fffbeb;--red:#ef4444;--red-bg:#fef2f2}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:'DM Sans',sans-serif;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:'Plus Jakarta Sans',sans-serif;letter-spacing:-.03em}
.layout{display:flex;min-height:100vh}
.main-content{margin-left:250px;flex:1;padding:36px 40px 60px;max-width:1300px}
.header-bar{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:28px}
.header-bar h1{margin:6px 0 0;font-size:2.2rem;font-weight:800}.header-bar p{margin:4px 0 0;color:var(--muted);font-size:.95rem}
.db-status{display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:99px;font-size:.78rem;font-weight:700;background:var(--surface);border:1px solid var(--line)}
.db-status.online i{background:var(--green);box-shadow:0 0 0 3px #10b98122}.db-status.offline i{background:var(--red)}.db-status i{width:8px;height:8px;border-radius:50%;display:inline-block}
.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-bottom:32px}
.metric-card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:22px;box-shadow:0 4px 20px rgba(112,72,232,.03)}
.metric-card label{display:block;color:var(--muted);font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em}
.metric-card strong{display:block;margin:10px 0 4px;font:800 1.85rem 'Plus Jakarta Sans';color:var(--ink)}
.metric-card small{color:#837694;font-size:.8rem;font-weight:500}
.tab-bar{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;border-bottom:1px solid var(--line);padding-bottom:12px}
.tabs{display:flex;gap:10px}
.tab-btn{border:0;background:transparent;padding:10px 18px;font:700 .9rem 'DM Sans';color:var(--muted);cursor:pointer;border-radius:10px;transition:all .15s ease}
.tab-btn.active{background:var(--surface);color:var(--v);box-shadow:0 2px 10px rgba(112,72,232,.08);border:1px solid var(--line)}
.tab-actions{display:flex;gap:12px;align-items:center}
.search-box input{border:1px solid var(--line);border-radius:10px;padding:9px 14px;font:500 .86rem 'DM Sans';color:var(--ink);background:var(--surface);outline:none;width:240px}
.filter-select{border:1px solid var(--line);border-radius:10px;padding:9px 14px;font:600 .84rem 'DM Sans';color:var(--ink);background:var(--surface);cursor:pointer}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(112,72,232,.04)}
.table{width:100%;border-collapse:collapse;text-align:left;font-size:.88rem}
.table th{background:#fbf9fe;padding:14px 20px;color:var(--muted);font-weight:700;font-size:.78rem;text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid var(--line)}
.table td{padding:16px 20px;border-bottom:1px solid #f4effa;vertical-align:middle}
.table tr:last-child td{border-bottom:0}.table tr:hover td{background:#fdfcff}
.status-badge{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:8px;font-size:.76rem;font-weight:700}
.status-badge.paid{background:var(--green-bg);color:#065f46}.status-badge.pending{background:var(--yellow-bg);color:#92400e}.status-badge.cancelled,.status-badge.expired{background:var(--red-bg);color:#991b1b}
.status-dot{width:6px;height:6px;border-radius:50%;background:currentColor}
.btn-action{border:1px solid var(--line);border-radius:8px;padding:6px 14px;background:var(--surface);color:var(--v);font:700 .8rem 'DM Sans';cursor:pointer;transition:all .15s ease}
.btn-action:hover{background:var(--v);color:#fff;border-color:var(--v)}
.product-img{width:38px;height:38px;border-radius:10px;object-fit:cover;background:var(--l);display:grid;place-items:center;font-weight:800;color:var(--v)}
dialog#order-modal{border:0;border-radius:22px;padding:0;width:min(660px,calc(100% - 32px));background:var(--surface);box-shadow:0 32px 96px rgba(25,16,38,.32)}
dialog#order-modal::backdrop{background:rgba(25,16,38,.5);backdrop-filter:blur(6px)}
.modal-head{padding:22px 28px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:16px}
.modal-head h3{margin:0;font-size:1.15rem;font-weight:800;color:var(--ink)}
.close-modal{border:0;background:var(--l);min-width:32px;height:32px;border-radius:50%;color:var(--ink);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:all .15s ease;flex-shrink:0}
.close-modal:hover{background:var(--v);color:#fff}
.modal-body{padding:22px 28px 28px;max-height:76vh;overflow-y:auto}
.modal-body::-webkit-scrollbar{width:5px}
.modal-body::-webkit-scrollbar-track{background:transparent}
.modal-body::-webkit-scrollbar-thumb{background:var(--line);border-radius:4px}
.modal-section{background:#faf8fe;border:1px solid var(--line);border-radius:16px;padding:18px 20px;margin-bottom:16px}
.section-title{font-size:.82rem;font-weight:800;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin:16px 0 10px}
.detail-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px 20px}
.detail-item label{display:block;color:var(--muted);font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;margin-bottom:3px}
.detail-item span{display:block;font-weight:700;font-size:.9rem;color:var(--ink)}
.item-row{display:flex;justify-content:space-between;align-items:center;padding:11px 0;border-bottom:1px dashed var(--line)}
.item-row:last-child{border-bottom:0}
.item-info b{display:block;font-size:.9rem;color:var(--ink);font-weight:700}
.item-info span{font-size:.8rem;color:var(--muted)}
.item-price{font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;font-size:.92rem;color:var(--ink)}
.modal-total-bar{display:flex;justify-content:space-between;align-items:center;padding:14px 0 0;margin-top:8px;border-top:2px solid var(--line)}
.modal-total-bar label{font-weight:800;font-size:1rem;color:var(--ink)}
.modal-total-bar span{font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:1.3rem;color:var(--v)}
.credential-box{background:linear-gradient(135deg,#1e1135 0%,#191026 100%);color:#fff;padding:20px 22px;border-radius:16px;position:relative;box-shadow:0 8px 32px rgba(25,16,38,.2)}
.credential-box-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;padding-bottom:12px;border-bottom:1px solid rgba(255,255,255,.1)}
.credential-box-head span{font-size:.72rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:#c4b5fd}
.credential-box pre{margin:0;font-family:'Fira Code','Courier New',monospace;font-size:.88rem;line-height:1.7;color:#f3edff;white-space:pre-wrap;word-break:break-all}
.copy-cred-btn{border:0;background:rgba(112,72,232,.7);color:#fff;padding:7px 14px;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:.78rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:all .15s ease;flex-shrink:0}
.copy-cred-btn:hover{background:var(--v);transform:translateY(-1px)}
@media(max-width:900px){.layout{flex-direction:column}.main-content{margin-left:0;padding:24px 20px}.metrics{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.metrics{grid-template-columns:1fr}.header-bar{flex-direction:column;align-items:flex-start;gap:12px}.tab-bar{flex-direction:column;align-items:stretch;gap:12px}.detail-grid{grid-template-columns:1fr}}
/* ── Analytics Financial Cards ── */
.analytics-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}
.an-card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:20px 22px;box-shadow:0 2px 12px rgba(112,72,232,.04);transition:box-shadow .2s}
.an-card:hover{box-shadow:0 6px 24px rgba(112,72,232,.08)}
.an-card-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px}
.an-label{font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
.an-icon{width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.an-icon-blue{background:#eff6ff;color:#3b82f6}
.an-icon-green{background:var(--green-bg);color:var(--green)}
.an-icon-purple{background:var(--l);color:var(--v)}
.an-icon-red{background:var(--red-bg);color:var(--red)}
.an-value{font:800 1.7rem 'Plus Jakarta Sans',sans-serif;color:var(--ink);margin-bottom:4px;line-height:1.1}
.an-value-red{color:var(--red)}
.an-unit{font-size:1rem;font-weight:600;color:var(--muted)}
.an-sub{font-size:.78rem;color:var(--muted);font-weight:500}
/* ── Analytics Row: panels ── */
.analytics-row{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:28px}
.an-panel{background:var(--surface);border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:0 2px 12px rgba(112,72,232,.04)}
.an-panel-head{display:flex;justify-content:space-between;align-items:flex-start;padding:18px 22px;border-bottom:1px solid var(--line);background:#fbf9fe}
.an-panel-head h3{margin:0 0 2px;font-size:1rem;font-weight:800;color:var(--ink)}
.an-panel-head p{margin:0;font-size:.78rem;color:var(--muted)}
.an-badge{display:inline-flex;align-items:center;padding:4px 12px;border-radius:99px;font-size:.72rem;font-weight:800;flex-shrink:0;margin-top:2px}
.an-badge-green{background:var(--green-bg);color:#065f46}
.an-badge-red{background:var(--red-bg);color:#991b1b}
.an-panel-body{padding:6px 0}
/* Top Selling */
.top-list{display:flex;flex-direction:column}
.top-row{display:flex;align-items:center;gap:12px;padding:13px 22px;border-bottom:1px solid #f4effa}
.top-row:last-child{border-bottom:0}
.top-rank{width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;font:800 .8rem 'Plus Jakarta Sans';flex-shrink:0;background:var(--l);color:var(--v)}
.rank-1{background:linear-gradient(135deg,#fbbf24,#f59e0b);color:#fff;box-shadow:0 2px 8px rgba(245,158,11,.3)}
.rank-2{background:linear-gradient(135deg,#9ca3af,#6b7280);color:#fff}
.rank-3{background:linear-gradient(135deg,#d97706,#b45309);color:#fff}
.top-info{flex:1;min-width:0}
.top-name{font-weight:700;font-size:.88rem;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.top-meta{font-size:.74rem;color:var(--muted);margin-top:2px;font-weight:500}
.top-bar-wrap{width:90px;height:7px;background:var(--l);border-radius:99px;overflow:hidden;flex-shrink:0}
.top-bar{height:100%;background:linear-gradient(90deg,var(--v),var(--v2));border-radius:99px;transition:width .4s ease}
/* Low Stock */
.low-list{display:flex;flex-direction:column}
.low-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 22px;border-bottom:1px solid #f4effa}
.low-row:last-child{border-bottom:0}
.low-info{flex:1;min-width:0}
.low-name{font-weight:700;font-size:.88rem;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.low-type{font-size:.73rem;color:var(--muted);margin-top:2px}
.low-right{display:flex;align-items:center;gap:8px;flex-shrink:0}
.stock-pill{padding:3px 10px;border-radius:99px;font-size:.72rem;font-weight:800}
.stock-empty{background:var(--red-bg);color:#991b1b}
.stock-warn{background:var(--yellow-bg);color:#92400e}
.restock-btn{padding:5px 12px;border-radius:8px;background:var(--v);color:#fff;font:700 .75rem 'DM Sans';text-decoration:none;transition:background .15s}
.restock-btn:hover{background:var(--v2)}
/* Empty states */
.an-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:40px 20px;color:var(--muted)}
.an-empty p{margin:0;font-size:.88rem;font-weight:500}
.an-empty-green svg{color:var(--green)}.an-empty-green p{color:var(--green)}
@media(max-width:1100px){.analytics-cards{grid-template-columns:repeat(2,1fr)}.analytics-row{grid-template-columns:1fr}}
@media(max-width:700px){.analytics-cards{grid-template-columns:1fr}}
</style>


</head>
<body>

<div class="layout">
  <AdminSidebar active="dashboard" />

  <main class="main-content">
    <div class="header-bar">
      <div>
        <h1>Dashboard Admin</h1>
        <p>Ringkasan penjualan, produk terlaris, dan peringatan stok toko.</p>
      </div>
      <div class={connected ? "db-status online" : "db-status offline"}>
        <i></i>
        <span>{connected ? 'Database Terhubung' : 'Database Terputus'}</span>
      </div>
    </div>

    <!-- Stat Cards: Financial Analytics -->
    <section class="analytics-cards">
      <div class="an-card">
        <div class="an-card-top">
          <span class="an-label">Penjualan Hari Ini</span>
          <span class="an-icon an-icon-blue">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </span>
        </div>
        <div class="an-value">{formatRupiah(dailyRevenue)}</div>
        <div class="an-sub">Total omset hari ini</div>
      </div>
      <div class="an-card">
        <div class="an-card-top">
          <span class="an-label">Penjualan Minggu Ini</span>
          <span class="an-icon an-icon-green">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </span>
        </div>
        <div class="an-value">{formatRupiah(weeklyRevenue)}</div>
        <div class="an-sub">Total omset minggu berjalan</div>
      </div>
      <div class="an-card">
        <div class="an-card-top">
          <span class="an-label">Penjualan Bulan Ini</span>
          <span class="an-icon an-icon-purple">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </span>
        </div>
        <div class="an-value">{formatRupiah(monthlyRevenue)}</div>
        <div class="an-sub">Total omset bulan ini</div>
      </div>
      <div class="an-card">
        <div class="an-card-top">
          <span class="an-label">Stok Tipis (&lt;3 Unit)</span>
          <span class={`an-icon ${lowStockCount > 0 ? 'an-icon-red' : 'an-icon-green'}`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </span>
        </div>
        <div class={`an-value ${lowStockCount > 0 ? 'an-value-red' : ''}`}>{lowStockCount} <span class="an-unit">Produk</span></div>
        <div class="an-sub">{lowStockCount > 0 ? 'Perlu restok segera!' : 'Semua stok aman'}</div>
      </div>
    </section>

    <!-- Analytics Row: Top Selling + Low Stock Alert -->
    <div class="analytics-row">
      <!-- Top Selling Products -->
      <div class="an-panel">
        <div class="an-panel-head">
          <div>
            <h3>Produk Terlaris</h3>
            <p>Berdasarkan unit terjual dari order lunas</p>
          </div>
          <span class="an-badge an-badge-green">Top 5</span>
        </div>
        <div class="an-panel-body">
          {topSellingProducts.length > 0 ? (
            <div class="top-list">
              {topSellingProducts.map((p, i) => (
                <div class="top-row">
                  <span class={`top-rank rank-${i + 1}`}>#{i + 1}</span>
                  <div class="top-info">
                    <div class="top-name">{p.product_name}</div>
                    <div class="top-meta">{formatRupiah(p.totalRevenue)} &middot; {p.totalQty} unit terjual</div>
                  </div>
                  <div class="top-bar-wrap">
                    <div class="top-bar" style={`width:${Math.max(12, Math.round((p.totalQty / topSellingProducts[0].totalQty) * 100))}%`}></div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="an-empty">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              <p>Belum ada data penjualan.</p>
            </div>
          )}
        </div>
      </div>
      <!-- Low Stock Alert -->
      <div class="an-panel">
        <div class="an-panel-head">
          <div>
            <h3>Peringatan Stok Tipis</h3>
            <p>Produk aktif dengan stok &lt; 3 unit</p>
          </div>
          {lowStockCount > 0
            ? <span class="an-badge an-badge-red">{lowStockCount} Perlu Restok</span>
            : <span class="an-badge an-badge-green">Stok Aman</span>
          }
        </div>
        <div class="an-panel-body">
          {lowStockProducts.length > 0 ? (
            <div class="low-list">
              {lowStockProducts.map((p) => (
                <div class="low-row">
                  <div class="low-info">
                    <div class="low-name">{p.name}</div>
                    <div class="low-type">{p.isAccountBased ? 'Stok Akun (Auto)' : 'Stok Manual'}</div>
                  </div>
                  <div class="low-right">
                    <span class={`stock-pill ${p.currentQty === 0 ? 'stock-empty' : 'stock-warn'}`}>
                      {p.currentQty === 0 ? 'Habis' : `Sisa ${p.currentQty}`}
                    </span>
                    <a href="/dashboard/accounts" class="restock-btn">Isi Stok</a>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="an-empty an-empty-green">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <p>Semua stok produk cukup (&ge; 3 unit).</p>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Tab Bar -->
    <div class="tab-bar">
      <div class="tabs">
        <button type="button" class="tab-btn active" id="tab-orders">Riwayat Pembelian</button>
        <button type="button" class="tab-btn" id="tab-products">Katalog & Stok Produk</button>
      </div>
      <div class="tab-actions">
        <div class="search-box">
          <input type="text" id="order-search" placeholder="Cari nama, email, order..." />
        </div>
        <select id="status-filter" class="filter-select">
          <option value="all">Semua Status</option>
          <option value="paid">Lunas / Paid</option>
          <option value="pending">Menunggu Bayar</option>
          <option value="cancelled">Dibatalkan</option>
          <option value="expired">Kedaluwarsa</option>
        </select>
      </div>
    </div>

    <!-- Panel 1: Orders History -->
    <div id="panel-orders" class="panel">
      <table class="table">
        <thead>
          <tr>
            <th>Nomor Order</th>
            <th>Tanggal</th>
            <th>Pelanggan</th>
            <th>Total Bayar</th>
            <th>Status</th>
            <th style="text-align: right">Aksi</th>
          </tr>
        </thead>
        <tbody id="orders-tbody">
          {orders.map((o) => (
            <tr data-status={o.status} data-search={`${o.order_number} ${o.customer_name} ${o.customer_email}`.toLowerCase()}>
              <td><b style="font-family: 'Plus Jakarta Sans'">{o.order_number}</b></td>
              <td>{new Date(o.created_at).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' })}</td>
              <td>
                <div><b>{o.customer_name}</b></div>
                <small style="color: var(--muted)">{o.customer_email}</small>
              </td>
              <td><b style="color: var(--ink)">{formatRupiah(o.total_amount)}</b></td>
              <td>
                <span class={`status-badge ${o.status}`}>
                  <i class="status-dot"></i>
                  {o.status === 'paid' ? 'Paid' : o.status === 'pending' ? 'Pending' : o.status === 'cancelled' || o.status === 'expired' ? 'Cancelled' : o.status}
                </span>
              </td>
              <td style="text-align: right">
                <button type="button" class="btn-action view-order-btn" data-id={o.id}>Detail</button>
              </td>
            </tr>
          ))}
          {orders.length === 0 && (
            <tr>
              <td colspan="6" style="text-align: center; padding: 32px; color: var(--muted)">Belum ada riwayat pesanan.</td>
            </tr>
          )}
        </tbody>
      </table>
      <div id="orders-pagination" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; border-top: 1px solid var(--line); font-size: .84rem; color: var(--muted); background: #fff">
        <span id="orders-page-info">Menampilkan 0 pesanan</span>
        <div style="display: flex; gap: 8px">
          <button type="button" id="orders-prev-btn" class="btn-action" style="padding: 6px 14px">← Prev</button>
          <button type="button" id="orders-next-btn" class="btn-action" style="padding: 6px 14px">Next →</button>
        </div>
      </div>
    </div>

    <!-- Panel 2: Products Catalog -->
    <div id="panel-products" class="panel" style="display: none">
      <div style="padding: 16px 20px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center">
        <h3 style="margin: 0">Daftar Produk ({products.length})</h3>
        <a href="/dashboard/products/new" class="btn-action" style="background: var(--v); color: #fff; text-decoration: none; border: 0">+ Tambah Produk</a>
      </div>
      <table class="table">
        <thead>
          <tr>
            <th>Produk</th>
            <th>Kategori</th>
            <th>Harga Base</th>
            <th>Stok Tersedia</th>
            <th>Status</th>
            <th style="text-align: right">Aksi</th>
          </tr>
        </thead>
        <tbody id="products-tbody">
          {products.map((p) => (
            <tr>
              <td>
                <div style="display: flex; align-items: center; gap: 12px">
                  <div class="product-img">
                    {stockFor(p.id)?.image_url ? <img src={stockFor(p.id)?.image_url!} alt={p.name} style="width:100%;height:100%;object-fit:cover;border-radius:10px"/> : p.name.charAt(0)}
                  </div>
                  <div>
                    <b>{p.name}</b>
                    <div style="font-size: .78rem; color: var(--muted)">{p.duration}</div>
                  </div>
                </div>
              </td>
              <td><span style="padding: 3px 8px; border-radius: 6px; background: var(--l); color: var(--v); font-size: .75rem; font-weight: 700">{p.category}</span></td>
              <td><b>{formatRupiah(p.price)}</b></td>
              <td>
                <b style={quantityFor(p.id) > 5 ? "color: var(--green)" : "color: var(--red)"}>{quantityFor(p.id)} unit</b>
              </td>
              <td>
                <span class={`status-badge ${isProductActive(p) ? 'paid' : 'cancelled'}`}>
                  {isProductActive(p) ? 'Aktif' : 'Nonaktif'}
                </span>
              </td>
              <td style="text-align: right">
                <a href={`/dashboard/products/${p.id}`} class="btn-action" style="text-decoration: none">Edit</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <div id="products-pagination" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; border-top: 1px solid var(--line); font-size: .84rem; color: var(--muted); background: #fff">
        <span id="products-page-info">Menampilkan 0 produk</span>
        <div style="display: flex; gap: 8px">
          <button type="button" id="products-prev-btn" class="btn-action" style="padding: 6px 14px">← Prev</button>
          <button type="button" id="products-next-btn" class="btn-action" style="padding: 6px 14px">Next →</button>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Modal Dialog Detail Order -->
<dialog id="order-modal">
  <div class="modal-head">
    <div class="modal-head-left">
      <h3>Detail Transaksi</h3>
      <div class="modal-order-meta">
        <span id="modal-order-number-badge" class="order-id-tag"></span>
        <span id="modal-status-badge"></span>
      </div>
    </div>
    <button type="button" class="close-modal" id="modal-close-btn" aria-label="Tutup">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>
  <div class="modal-body" id="modal-content">
    <div style="text-align: center; padding: 40px; color: var(--muted)">Memuat detail pesanan...</div>
  </div>
</dialog>



<script>
  const tabOrders = document.getElementById('tab-orders');
  const tabProducts = document.getElementById('tab-products');
  const panelOrders = document.getElementById('panel-orders');
  const panelProducts = document.getElementById('panel-products');

  tabOrders?.addEventListener('click', () => {
    tabOrders.classList.add('active');
    tabProducts?.classList.remove('active');
    if (panelOrders) panelOrders.style.display = 'block';
    if (panelProducts) panelProducts.style.display = 'none';
  });

  tabProducts?.addEventListener('click', () => {
    tabProducts.classList.add('active');
    tabOrders?.classList.remove('active');
    if (panelProducts) panelProducts.style.display = 'block';
    if (panelOrders) panelOrders.style.display = 'none';
  });

  const searchInput = document.getElementById('order-search') as HTMLInputElement;
  const statusSelect = document.getElementById('status-filter') as HTMLSelectElement;
  const orderRows = document.querySelectorAll('#orders-tbody tr[data-status]');

  // Orders Pagination & Filtering
  let currentOrdersPage = 1;
  const ordersPerPage = 10;

  function renderOrdersPagination() {
    const q = (searchInput?.value || '').toLowerCase().trim();
    const st = statusSelect?.value || 'all';

    const visibleRows: HTMLElement[] = [];
    orderRows.forEach((row) => {
      const el = row as HTMLElement;
      const rowStatus = el.dataset.status;
      const rowSearch = el.dataset.search || '';
      const matchesStatus = st === 'all' || rowStatus === st;
      const matchesSearch = !q || rowSearch.includes(q);

      if (matchesStatus && matchesSearch) {
        visibleRows.push(el);
      } else {
        el.style.display = 'none';
      }
    });

    const totalVisible = visibleRows.length;
    const totalPages = Math.ceil(totalVisible / ordersPerPage) || 1;
    if (currentOrdersPage > totalPages) currentOrdersPage = totalPages;
    if (currentOrdersPage < 1) currentOrdersPage = 1;

    const startIdx = (currentOrdersPage - 1) * ordersPerPage;
    const endIdx = startIdx + ordersPerPage;

    visibleRows.forEach((el, idx) => {
      el.style.display = idx >= startIdx && idx < endIdx ? '' : 'none';
    });

    const infoEl = document.getElementById('orders-page-info');
    if (infoEl) {
      if (totalVisible === 0) {
        infoEl.textContent = 'Tidak ada pesanan';
      } else {
        infoEl.textContent = `Menampilkan ${startIdx + 1}–${Math.min(endIdx, totalVisible)} dari ${totalVisible} pesanan (Hal ${currentOrdersPage}/${totalPages})`;
      }
    }

    const prevBtn = document.getElementById('orders-prev-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('orders-next-btn') as HTMLButtonElement;
    if (prevBtn) {
      prevBtn.disabled = currentOrdersPage <= 1;
      prevBtn.style.opacity = currentOrdersPage <= 1 ? '0.5' : '1';
      prevBtn.style.cursor = currentOrdersPage <= 1 ? 'not-allowed' : 'pointer';
    }
    if (nextBtn) {
      nextBtn.disabled = currentOrdersPage >= totalPages;
      nextBtn.style.opacity = currentOrdersPage >= totalPages ? '0.5' : '1';
      nextBtn.style.cursor = currentOrdersPage >= totalPages ? 'not-allowed' : 'pointer';
    }
  }

  searchInput?.addEventListener('input', () => { currentOrdersPage = 1; renderOrdersPagination(); });
  statusSelect?.addEventListener('change', () => { currentOrdersPage = 1; renderOrdersPagination(); });
  document.getElementById('orders-prev-btn')?.addEventListener('click', () => {
    if (currentOrdersPage > 1) { currentOrdersPage--; renderOrdersPagination(); }
  });
  document.getElementById('orders-next-btn')?.addEventListener('click', () => {
    currentOrdersPage++; renderOrdersPagination();
  });
  renderOrdersPagination();

  // Products Pagination
  let currentProductsPage = 1;
  const productsPerPage = 10;
  const productRows = document.querySelectorAll('#products-tbody tr');

  function renderProductsPagination() {
    const totalVisible = productRows.length;
    const totalPages = Math.ceil(totalVisible / productsPerPage) || 1;
    if (currentProductsPage > totalPages) currentProductsPage = totalPages;
    if (currentProductsPage < 1) currentProductsPage = 1;

    const startIdx = (currentProductsPage - 1) * productsPerPage;
    const endIdx = startIdx + productsPerPage;

    productRows.forEach((row, idx) => {
      (row as HTMLElement).style.display = idx >= startIdx && idx < endIdx ? '' : 'none';
    });

    const infoEl = document.getElementById('products-page-info');
    if (infoEl) {
      if (totalVisible === 0) {
        infoEl.textContent = 'Tidak ada produk';
      } else {
        infoEl.textContent = `Menampilkan ${startIdx + 1}–${Math.min(endIdx, totalVisible)} dari ${totalVisible} produk (Hal ${currentProductsPage}/${totalPages})`;
      }
    }

    const prevBtn = document.getElementById('products-prev-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('products-next-btn') as HTMLButtonElement;
    if (prevBtn) {
      prevBtn.disabled = currentProductsPage <= 1;
      prevBtn.style.opacity = currentProductsPage <= 1 ? '0.5' : '1';
      prevBtn.style.cursor = currentProductsPage <= 1 ? 'not-allowed' : 'pointer';
    }
    if (nextBtn) {
      nextBtn.disabled = currentProductsPage >= totalPages;
      nextBtn.style.opacity = currentProductsPage >= totalPages ? '0.5' : '1';
      nextBtn.style.cursor = currentProductsPage >= totalPages ? 'not-allowed' : 'pointer';
    }
  }

  document.getElementById('products-prev-btn')?.addEventListener('click', () => {
    if (currentProductsPage > 1) { currentProductsPage--; renderProductsPagination(); }
  });
  document.getElementById('products-next-btn')?.addEventListener('click', () => {
    currentProductsPage++; renderProductsPagination();
  });
  renderProductsPagination();

  const modal = document.getElementById('order-modal') as HTMLDialogElement;
  const modalCloseBtn = document.getElementById('modal-close-btn');
  const modalContent = document.getElementById('modal-content');

  modalCloseBtn?.addEventListener('click', () => modal?.close());
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });

  function formatRupiahJs(amount: number) {
    return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(amount);
  }

  document.querySelectorAll('.view-order-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const orderId = (btn as HTMLElement).dataset.id;
      if (!orderId || !modal || !modalContent) return;

      modalContent.innerHTML = '<div style="text-align: center; padding: 36px; color: var(--muted)">Memuat data pesanan...</div>';
      modal.showModal();

      try {
        const res = await fetch(`/api/admin/orders?id=${orderId}`);
        if (!res.ok) throw new Error('Gagal mengambil data.');
        const data = await res.json();
        const { order, items, payment, assignedAccount } = data;

        const dateStr = new Date(order.created_at).toLocaleString('id-ID', {
          dateStyle: 'full',
          timeStyle: 'medium'
        });

        const badgeEl = document.getElementById('modal-order-number-badge');
        if (badgeEl) badgeEl.textContent = order.order_number;

        const statusBadgeEl = document.getElementById('modal-status-badge');
        if (statusBadgeEl) {
          statusBadgeEl.className = `status-badge ${order.status}`;
          const statusLabel = order.status === 'paid' ? 'Lunas' : order.status === 'pending' ? 'Pending' : order.status === 'cancelled' || order.status === 'expired' ? 'Dibatalkan' : order.status;
          statusBadgeEl.innerHTML = `<i class="status-dot"></i> ${statusLabel}`;
        }

        let itemsHtml = items.map((it: any) => `
          <div class="item-row">
            <div class="item-info">
              <b>${it.product_name}</b>
              <span>Kuantitas: ${it.quantity} unit</span>
            </div>
            <div class="item-price">${formatRupiahJs(it.price * it.quantity)}</div>
          </div>
        `).join('');

        let accountSection = '';
        if (order.status === 'paid') {
          if (assignedAccount) {
            const credText = `Email/Login: ${assignedAccount.login}\nPassword   : ${assignedAccount.password}`;
            accountSection = `
              <div class="section-title">Detail Akun Diserahkan</div>
              <div class="credential-box">
                <div class="credential-box-head">
                  <span>Akses Akun Premium</span>
                  <button type="button" class="copy-cred-btn" id="copy-cred-btn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                    Salin Akun
                  </button>
                </div>
                <pre id="cred-text">${credText}</pre>
              </div>
            `;
          } else {
            accountSection = `
              <div class="section-title">Detail Akun Diserahkan</div>
              <div style="padding: 14px 18px; background: #fffbeb; color: #92400e; border: 1px solid #fde68a; border-radius: 12px; font-size: .86rem; font-weight: 600; display: flex; align-items: center; gap: 8px">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                Stok akun belum dikaitkan secara otomatis atau akun belum tersedia.
              </div>
            `;
          }
        }

        const statusLabel = order.status === 'paid' ? 'PAID / LUNAS' : order.status === 'pending' ? 'PENDING' : order.status.toUpperCase();

        modalContent.innerHTML = `
          <div class="modal-section">
            <span class="section-title">Info Transaksi</span>
            <div class="detail-grid">
              <div class="detail-item">
                <label>Nama Pembeli</label>
                <span>${order.customer_name}</span>
              </div>
              <div class="detail-item">
                <label>Email Pembeli</label>
                <span>${order.customer_email}</span>
              </div>
              <div class="detail-item">
                <label>Waktu Transaksi</label>
                <span style="font-size:.84rem">${dateStr}</span>
              </div>
              <div class="detail-item">
                <label>Referensi QRIS</label>
                <span style="font-family:monospace;font-size:.84rem">${payment?.reference_id || '—'}</span>
              </div>
            </div>
          </div>

          <div class="modal-section" style="padding: 14px 20px">
            <span class="section-title">Item Produk</span>
            ${itemsHtml}
            <div class="modal-total-bar">
              <label>Total Bayar</label>
              <span>${formatRupiahJs(order.total_amount)}</span>
            </div>
          </div>

          ${accountSection}
        `;

        document.getElementById('copy-cred-btn')?.addEventListener('click', () => {
          const text = document.getElementById('cred-text')?.textContent;
          if (text) {
            navigator.clipboard.writeText(text);
            const btn = document.getElementById('copy-cred-btn');
            if (btn) {
              btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Tersalin!';
              setTimeout(() => {
                if (btn) btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> Salin Akun';
              }, 2000);
            }
          }
        });
      } catch (err) {
        modalContent.innerHTML = '<div style="text-align: center; padding: 32px 20px;"><div style="color: var(--red); font-weight: 700; margin-bottom: 8px">Gagal memuat detail pesanan.</div><div style="font-size: .85rem; color: var(--muted)" id="error-detail-msg">Pastikan sesi admin Anda masih aktif atau periksa koneksi server.</div></div>';
      }
    });
  });

</script>
</body>
</html>
