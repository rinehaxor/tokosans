---
import { Clock3, Copy, LockKeyhole, QrCode, ShieldCheck } from '@lucide/astro';
import OrderLookupModal from '../../components/OrderLookupModal';
import PaymentSuccessModal from '../../components/PaymentSuccessModal';
const { reference } = Astro.params;
---
<html lang="id"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png"/><link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png"/><link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png"/><title>Pembayaran QRIS — tokosans.</title><link rel='preconnect' href='https://fonts.googleapis.com'/><link rel='preconnect' href='https://fonts.gstatic.com' crossorigin/><link href='https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Plus+Jakarta+Sans:wght@600;700;800' rel='stylesheet'/><style>:root{--ink:#211530;--muted:#776d83;--violet:#7048e8;--line:#e8e1f2}*{box-sizing:border-box}body{min-height:100vh;margin:0;background:#fbfaff;color:var(--ink);font-family:'DM Sans',sans-serif}.shell{width:min(1080px,calc(100% - 40px));margin:auto;padding:28px 0 44px}.top{display:flex;justify-content:space-between;align-items:center;gap:20px}.logo{font-size:1.4rem;font-weight:800;color:var(--ink);text-decoration:none}.logo b{color:var(--violet)}.nav{display:flex;align-items:center;gap:9px;margin-left:auto}.nav a{color:#fff;text-decoration:none;border:1px solid var(--violet);border-radius:10px;padding:9px 14px;font-size:.76rem;font-weight:700;background:var(--violet);box-shadow:0 6px 18px #7048e830;transition:transform .18s cubic-bezier(.34,1.56,.64,1),box-shadow .18s,background .18s}.nav a:hover{color:#fff;border-color:#5b34d1;background:#5b34d1;transform:translateY(-1px);box-shadow:0 10px 26px #7048e840}.nav a:active{transform:scale(.96)}.secure{display:flex;gap:7px;align-items:center;color:#756788;font-size:.8rem}.secure svg{width:15px}.grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr);gap:24px;margin-top:38px;align-items:start}.card{background:#fff;border:1px solid var(--line);border-radius:23px;padding:32px;box-shadow:0 22px 55px #3d1c7010}.summary{position:sticky;top:22px}.summary h2{font-size:1.25rem;margin:0 0 26px}.qr-box{min-height:320px}.card-head{display:flex;align-items:center;flex-wrap:wrap;gap:10px 14px;margin:0 0 20px}.back-link{display:inline-flex;align-items:center;gap:6px;margin:0;padding:7px 13px;border:1px solid #e4dafa;border-radius:100px;background:#faf8ff;color:var(--violet);font-size:.78rem;font-weight:700;line-height:1.2;text-decoration:none;transition:background .18s,border-color .18s,transform .18s cubic-bezier(.34,1.56,.64,1),box-shadow .18s}.back-link:hover{background:#f0ebff;border-color:#c3adf5;transform:translateX(-2px);box-shadow:0 4px 12px #7048e818}.back-link:active{transform:scale(.96)}.back-link span{font-size:.9em}.status{display:inline-flex;gap:7px;align-items:center;border-radius:100px;background:#f0edff;color:#603bc7;padding:7px 11px;font-size:.76rem;font-weight:700}.success{background:#e7f8ee;color:#17834e}.failed{background:#fff0ef;color:#c23f38}.hint{color:var(--muted);line-height:1.6}.qr-box{display:grid;place-items:center;min-height:286px;margin:25px 0;border:1px dashed #d7caef;border-radius:18px;background:#f7f3ff}.qr{width:min(238px,78%);max-height:238px;object-fit:contain;display:none}.qr-placeholder{text-align:center;color:#8a7aa1}.code{display:none;max-height:76px;overflow:auto;background:#f4f1fa;padding:10px;font:11px monospace;word-break:break-all}.account{display:none;margin-top:22px;border-radius:15px;background:#f0edff;padding:16px}.account h2{font-size:1rem;margin:0 0 12px}.email-notice{display:none;background:#eef2ff;border:1px solid #c7d2fe;color:#3730a3;border-radius:10px;padding:10px 12px;font-size:.78rem;line-height:1.45;margin-bottom:12px}.email-notice b{font-weight:700}.terms-title{display:none;margin:0 0 8px;font-size:.95rem}.account-terms{display:none;margin-top:14px;padding-top:12px;border-top:1px solid #dcd2f2;color:#5f5470;font-size:.82rem;line-height:1.55;white-space:pre-wrap}.credential{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 0;border-top:1px solid #dfd5fa}.credential small,.reference small,.row small{color:#756788;font-size:.72rem}.credential strong{word-break:break-all;text-align:right}.copy-field,.copy{display:inline-flex;align-items:center;justify-content:center;gap:5px;border:1px solid #d8c9fa;border-radius:8px;background:#fff;color:#6840d6;padding:7px 10px;cursor:pointer;font:600 .72rem 'DM Sans',sans-serif;white-space:nowrap;transition:background .18s,border-color .18s,color .18s,transform .18s cubic-bezier(.34,1.56,.64,1),box-shadow .18s}.copy-field:hover,.copy:hover{background:#f0ebff;border-color:#a98be9;transform:translateY(-1px);box-shadow:0 4px 12px #7048e820}.copy-field:active,.copy:active{transform:scale(.93)}.copy-field.copied,.copy.copied{background:#e7f8ee;border-color:#9ed9b8;color:#17834e;animation:copy-pop .25s cubic-bezier(.34,1.56,.64,1)}.copy-field svg,.copy svg{width:14px;height:14px;flex:none}@keyframes copy-pop{0%{transform:scale(.88)}60%{transform:scale(1.08)}100%{transform:scale(1)}}.reference{position:relative;padding:13px 54px 13px 13px}.copy{position:absolute;right:12px;bottom:12px;width:30px;height:30px;padding:0;border-radius:8px}.credential{min-width:0}.credential strong{min-width:0;flex:1}.account-terms .copy-field{margin-top:10px}@media(max-width:700px){.credential{gap:7px}.credential small{flex:0 0 72px}.credential strong{font-size:.88rem}.copy-field{padding:7px 8px}}.reference strong{display:block;margin-top:5px;word-break:break-all}.line{border:0;border-top:1px solid var(--line);margin:22px 0}.row{display:flex;justify-content:space-between;margin:14px 0}.footer-note{display:flex;justify-content:center;gap:7px;margin-top:19px;color:#81758e;font-size:.75rem}@media(max-width:700px){.shell{padding:22px 18px}.grid{grid-template-columns:1fr;margin-top:32px}.summary{grid-row:1}.card{padding:22px}}.countdown{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:16px 0 -7px;padding:11px 14px;border:1px solid #e4dafa;border-radius:11px;background:#faf8ff;color:#625275;font-size:.8rem}.countdown strong{color:#6840d6;font-size:1rem;letter-spacing:.04em}.countdown.expired{border-color:#f0c8c4;background:#fff5f4;color:#c23f38}.countdown.expired strong{color:#c23f38}.toast{position:fixed;right:22px;bottom:22px;z-index:10;display:flex;align-items:center;gap:9px;max-width:calc(100vw - 44px);padding:13px 16px;border:1px solid #9ed9b8;border-radius:12px;background:#e7f8ee;box-shadow:0 12px 30px #3d1c7020;color:#17834e;font-size:.84rem;font-weight:700;opacity:0;pointer-events:none;transform:translateY(12px);transition:opacity .2s,transform .2s}.toast.visible{opacity:1;transform:translateY(0)}@media(max-width:700px){.countdown{font-size:.75rem}.toast{right:16px;bottom:16px}} .qr-box.paid{display:none}.status{white-space:nowrap}@media(max-width:720px){.shell{width:min(100% - 28px,1080px);padding:20px 0 32px}.top{flex-wrap:wrap}.nav{order:3;width:100%;margin:4px 0 0}.nav a{flex:1;text-align:center;padding:10px 8px}.secure{margin-left:auto;font-size:0}.secure svg{width:18px}.grid{grid-template-columns:1fr;margin-top:24px}.summary{position:static}.card{padding:22px}.qr-box{min-height:270px}.toast{right:20px;left:20px;bottom:20px;text-align:center}}@media(max-width:420px){.logo{font-size:1.25rem}.nav a{font-size:.7rem}.status{font-size:.7rem}.card-head{gap:8px 10px}.back-link{font-size:.72rem;padding:6px 11px}.card{border-radius:18px;padding:18px}.qr-box{min-height:230px}.credential{flex-wrap:wrap}.credential strong{max-width:100%}} </style></head><body><main class="shell"><header class="top"><a class="logo" href="/">tokosans<b>.</b></a><nav class="nav" aria-label="Navigasi pembayaran"><OrderLookupModal client:load /><PaymentSuccessModal client:load /><a href="/">Kembali ke toko</a><a href="/#produk">Produk lainnya</a></nav><span class="secure"><LockKeyhole/> Pembayaran terenkripsi</span></header><div class="grid"><section class="card"><div class="card-head"><a class="back-link" href="/"><span aria-hidden="true">&larr;</span>Kembali ke toko</a><span id="status" class="status"><Clock3/> Menyiapkan pembayaran</span></div><div id="countdown" class="countdown" aria-live="polite"><span>Sisa waktu pembayaran</span><strong id="countdown-value">15:00</strong></div><h1 id="title">Scan QRIS untuk membayar</h1><p id="detail" class="hint">Mohon tunggu sebentar, kami sedang mengambil kode QR pembayaranmu.</p><div class="qr-box"><div id="placeholder" class="qr-placeholder"><QrCode/><div>QRIS akan tampil di sini</div></div><img id="qr" class="qr" alt="Kode QR pembayaran"/></div><div id="code" class="code"></div><div id="account" class="account"><h2>Akunmu</h2><div id="email-notice" class="email-notice">Detail akun juga dikirim ke email <b id="customer-email-text"></b>. Bila tidak ada di inbox utama, silakan cek folder <b>Spam</b>.</div><div class="credential"><small>Email/Login</small><strong id="account-login"></strong><button class="copy-field" data-copy="account-login" aria-label="Salin email atau login"><Copy size={14}/> <span>Salin</span></button></div><div class="credential"><small>Password</small><strong id="account-password"></strong><button class="copy-field" data-copy="account-password" aria-label="Salin password"><Copy size={14}/> <span>Salin</span></button></div><div id="account-terms" class="account-terms"><h3 class="terms-title">Syarat dan ketentuan</h3><div id="terms-content"></div><button class="copy-field" data-copy="terms-content" aria-label="Salin syarat dan ketentuan"><Copy size={14}/> <span>Salin S&K</span></button></div></div><p class="footer-note"><ShieldCheck/> Status pembayaran diperbarui otomatis</p></section><aside class="card summary"><h2>Detail pembayaran</h2><div class="reference"><small>Nomor referensi</small><strong>{reference}</strong><button id="copy" class="copy" title="Salin nomor referensi" aria-label="Salin nomor referensi"><Copy size={15}/></button></div><hr class="line"/><div class="row"><small>Metode pembayaran</small><b>QRIS Realtime</b></div><div class="row"><small>Total pembayaran</small><b id="amount">—</b></div></aside></div></main><div id="payment-toast" class="toast" role="status" aria-live="polite">? Pembayaran berhasil!</div><script define:vars={{ reference }}>const status=document.querySelector('#status'),countdown=document.querySelector('#countdown'),countdownValue=document.querySelector('#countdown-value'),toast=document.querySelector('#payment-toast'),title=document.querySelector('#title'),detail=document.querySelector('#detail'),qr=document.querySelector('#qr'),code=document.querySelector('#code'),placeholder=document.querySelector('#placeholder'),qrBox=document.querySelector('.qr-box'),amount=document.querySelector('#amount'),account=document.querySelector('#account'),accountLogin=document.querySelector('#account-login'),accountPassword=document.querySelector('#account-password'),accountTerms=document.querySelector('#account-terms'),termsTitle=document.querySelector('.terms-title'),termsContent=document.querySelector('#terms-content'),emailNotice=document.querySelector('#email-notice'),customerEmailText=document.querySelector('#customer-email-text'),copy=document.querySelector('#copy');let expiresAtMs=0,countdownTimer,paidNotified=false;function showPaidModal(d){if(paidNotified)return;paidNotified=true;window.dispatchEvent(new CustomEvent('payment:success',{detail:{productName:document.querySelector('#detail')?.dataset?.productName||undefined,amount:d.amount,reference:reference,account:d.account||undefined}}))}function updateCountdown(){if(!expiresAtMs)return;const remaining=Math.max(0,expiresAtMs-Date.now()),seconds=Math.ceil(remaining/1000),minutes=Math.floor(seconds/60),rest=String(seconds%60).padStart(2,'0');countdownValue.textContent=minutes+':'+rest;if(remaining<=0){countdown.classList.add('expired');countdownValue.textContent='Kedaluwarsa';clearInterval(countdownTimer)}}document.querySelectorAll('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{const target=document.querySelector('#'+button.dataset.copy);await navigator.clipboard.writeText(target.textContent||'');button.classList.add('copied');const label=button.querySelector('span');if(label){const old=label.textContent;label.textContent='Tersalin';setTimeout(()=>{label.textContent=old;button.classList.remove('copied')},1500)}}));copy.addEventListener('click',async()=>{await navigator.clipboard.writeText(reference);copy.classList.add('copied');copy.setAttribute('aria-label','Referensi tersalin');setTimeout(()=>{copy.classList.remove('copied');copy.setAttribute('aria-label','Salin nomor referensi')},1500)});function clearQr(){qr.removeAttribute('src');qr.style.display='none';placeholder.style.display='grid';code.textContent='';code.style.display='none'}async function refresh(){try{const r=await fetch(`/api/payments/${reference}/status`),d=await r.json();if(!r.ok){detail.textContent=d.message||'Pesanan tidak ditemukan.';return}try{const history=JSON.parse(localStorage.getItem('tokosans_order_history')||'[]');const idx=history.findIndex(o=>o.reference===reference);if(idx!==-1){history[idx].status=d.status;localStorage.setItem('tokosans_order_history',JSON.stringify(history));}}catch(e){}amount.textContent=new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(d.amount);if(d.expiresAt){expiresAtMs=new Date(d.expiresAt).getTime();updateCountdown();if(!countdownTimer)countdownTimer=setInterval(updateCountdown,1000)}if(d.status!=='pending')clearQr();else qrBox.classList.remove('paid');if(d.qrImageUrl||d.qrString){qr.src=d.qrImageUrl||`https://quickchart.io/qr?text=${encodeURIComponent(d.qrString)}&size=300`;qr.style.display='block';placeholder.style.display='none'}if(d.qrString){code.textContent=d.qrString;code.style.display='block'}if(d.customerEmail){customerEmailText.textContent=d.customerEmail;emailNotice.style.display='block'}if(d.account){accountLogin.textContent=d.account.login||'';accountPassword.textContent=d.account.password||'';termsContent.textContent=d.account.terms||'';termsTitle.style.display=d.account.terms?'block':'none';accountTerms.style.display=d.account.terms?'block':'none';account.style.display='block'}if(d.status==='paid'){qrBox.classList.add('paid');showPaidModal(d);countdown.style.display='none';status.textContent='✓ Pembayaran berhasil';status.className='status success';title.textContent='Terima kasih, pembayaran diterima!';detail.textContent=d.account?'Akunmu sudah tersedia di bawah ini.':'Pembayaran diterima. Akun sedang disiapkan.';if(d.account)return}if(['expired','failed','cancelled'].includes(d.status)){clearQr();countdown.classList.add('expired');countdownValue.textContent='Kedaluwarsa';status.textContent='Pembayaran tidak tersedia';status.className='status failed';title.textContent='Silakan buat pesanan baru';detail.textContent='QRIS telah kedaluwarsa atau pembayaran tidak berhasil.';return}status.textContent='◷ Menunggu pembayaran';setTimeout(refresh,4000)}catch{detail.textContent='Koneksi sedang bermasalah. Kami akan mencoba lagi.';setTimeout(refresh,5000)}}refresh();</script></body></html>
