.catalog{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.card{position:relative;background:#fff;border:1px solid #eee8f8;border-radius:20px;padding:20px;box-shadow:0 4px 16px rgba(0,0,0,0.02);transition:all .25s cubic-bezier(.16,1,.3,1);display:flex;flex-direction:column}
.card:hover{transform:translateY(-5px);box-shadow:0 16px 36px rgba(112,72,232,0.13);border-color:#d7c7fe}
.card-link{text-decoration:none;color:inherit;display:flex;flex-direction:column;height:100%}
