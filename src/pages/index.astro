import OrderLookupModal from '../components/OrderLookupModal';
import RecentSalesToast from '../components/RecentSalesToast.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import { formatRupiah } from '../lib/catalog';
import { getProducts } from '../lib/products';
import { getSiteUrl } from '../lib/site';

const siteUrl = getSiteUrl(Astro.url.origin);
const products = await getProducts();
const categories = [...new Set(products.map((product) => product.category))];
import { getSupabaseAdmin } from '../lib/supabase';
let productImages: Record<string, string> = {};
let soldCounts: Record<string, number> = {};
try {
  const db = getSupabaseAdmin();
  const { data: inventory } = await db.from('inventory').select('product_id,image_url,active');
  for (const item of inventory ?? []) if (item.active !== false && item.image_url) productImages[item.product_id] = item.image_url;
  await Promise.all(
    products.map(async (p) => {
      const { count } = await db
        .from('order_items')
        .select('id, orders!inner(status)', { count: 'exact', head: true })
        .eq('product_id', p.id)
        .in('orders.status', ['paid', 'completed']);
      if (count) soldCounts[p.id] = count;
    })
  );
} catch { /* fallback ke katalog lokal */ }
function formatSold(count: number): string {
  if (count >= 10000) return (Math.floor(count / 1000) * 1000).toLocaleString('id-ID') + '+';
  if (count >= 1000) return (Math.floor(count / 100) * 100).toLocaleString('id-ID') + '+';
  if (count >= 100) return (Math.floor(count / 10) * 10).toLocaleString('id-ID') + '+';
  if (count >= 10) return count.toLocaleString('id-ID') + '+';
  return count.toString();
}
function seededRating(id: string): string {
  let hash = 0;
  for (let i = 0; i < id.length; i++) hash = ((hash << 5) - hash + id.charCodeAt(i)) | 0;
  const ratings = ['4.7', '4.8', '4.8', '4.9', '4.9', '4.9', '5.0'];
  return ratings[Math.abs(hash) % ratings.length];
}
const benefits = [
  ['Harga Lebih Hemat', 'Dapatkan akses akun premium resmi dengan harga terjangkau. Hemat hingga 70% dibanding langganan reguler.'],
  ['Pengiriman Realtime 24/7', 'Sistem otomatis memproses pesanan detik itu juga. Akun langsung tampil di layar dan terkirim ke email.'],
  ['Garansi Penuh Masa Aktif', 'Seluruh layanan dilindungi garansi penggantian/perbaikan penuh selama durasi langganan berlangsung.'],
  ['Metode Pembayaran Mudah', 'Mendukung QRIS otomatis realtime dari m-banking dan e-wallet pilihan (GoPay, OVO, DANA, ShopeePay, BCA, dll).'],
  ['Cek Pesanan Kapan Saja', 'Lupa simpan kredensial? Gunakan fitur Cek Pesanan dengan email kamu untuk melihat kembali detail akun.'],
  ['Dukungan Siap Bantu', 'Tim bantuan kami selalu siap merespons dengan cepat jika kamu membutuhkan kendala atau panduan penggunaan.']
];
const faqs = [
  ['Apa itu tokosans.?', 'tokosans. adalah penyedia akses akun layanan digital premium (kreatif, produktivitas, hiburan) dengan proses otomatis instan, garansi penuh, dan harga terjangkau.'],
  ['Bagaimana cara membeli produk di tokosans.?', 'Pilih produk favoritmu, masukkan email aktif saat checkout, lalu selesaikan pembayaran. Akun akan langsung otomatis tampil di layar dan dikirim ke email kamu.'],
  ['Apakah akun di tokosans. bergaransi?', 'Ya! Semua akun dijamin aktif dan dilindungi garansi penuh (Repair/Replace) selama durasi masa aktif langganan.'],
  ['Bagaimana jika email akun tidak masuk?', 'Detail akun dikirimkan otomatis ke email kamu. Apabila tidak ada di inbox utama, silakan periksa folder Spam email kamu.'],
  ['Bagaimana jika saya lupa menyimpan akun?', 'Kamu bisa mengecek kembali pesananmu kapan saja melalui tombol Cek Pesanan di navigasi atas cukup dengan memasukkan alamat email kamu.']
];

// Schema.org Structured Data (JSON-LD)
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'OnlineStore',
  'name': 'tokosans.',
  'url': siteUrl,
  'logo': `${siteUrl}/favicon.svg`,
  'image': `${siteUrl}/og-image.png`,
  'description': 'Pusat langganan dan akses akun aplikasi digital premium instan, murah, dan bergaransi.',
  'paymentAccepted': 'QRIS, GoPay, OVO, DANA, ShopeePay, Bank Transfer',
  'currenciesAccepted': 'IDR',
  'hasMerchantReturnPolicy': {
    '@type': 'MerchantReturnPolicy',
    'applicableCountry': 'ID',
    'returnPolicyCategory': 'https://schema.org/MerchantReturnFiniteReturnWindow',
    'merchantReturnDays': 30,
    'returnMethod': 'https://schema.org/ReturnByMail',
    'returnFees': 'https://schema.org/FreeReturn'
  }
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'tokosans.',
  'url': siteUrl,
  'description': 'Akses Akun Digital Premium Legal & Murah di Indonesia'
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  'name': 'Katalog Layanan Digital Premium tokosans.',
  'itemListElement': products.map((p, idx) => ({
    '@type': 'ListItem',
    'position': idx + 1,
    'item': {
      '@type': 'Product',
      'name': p.name,
      'description': p.description,
      'image': productImages[p.id] || `${siteUrl}/favicon.svg`,
      'url': `${siteUrl}/checkout?product=${encodeURIComponent(p.id)}`,
      'brand': {
        '@type': 'Brand',
        'name': p.brand || p.name
      },
      'offers': {
        '@type': 'Offer',
        'price': p.price,
        'priceCurrency': 'IDR',
        'availability': p.active !== false ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
        'url': `${siteUrl}/checkout?product=${encodeURIComponent(p.id)}`,
        'seller': {
          '@type': 'Organization',
          'name': 'tokosans.'
        }
      },
      'aggregateRating': {
        '@type': 'AggregateRating',
        'ratingValue': seededRating(p.id),
        'bestRating': '5',
        'ratingCount': Math.max(25, soldCounts[p.id] || 30)
      }
    }
  }))
};
