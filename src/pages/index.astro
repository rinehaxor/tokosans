.benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:44px}
.benefit,.review{border:1px solid #e8e1f2;border-radius:20px;background:#fff;padding:28px;box-shadow:0 4px 16px rgba(0,0,0,0.02)}
