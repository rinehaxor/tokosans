  .preview{max-width:440px}
  .floating-logo{display:none}
  .section{padding:68px 0}
  .section-top{display:block}
  .section-top .copy{margin-top:16px}
  .catalog,.benefits,.reviews{grid-template-columns:repeat(2,1fr)}
  .proof-logos{grid-template-columns:repeat(3,1fr)}
  .footer-grid{grid-template-columns:1fr 1fr}
  .footer-grid>div:first-child{grid-column:1/-1}
}
@media(max-width:640px){
  .catalog{grid-template-columns:repeat(2,1fr);gap:12px}
  .card{padding:14px;border-radius:16px}
  .app-icon{width:46px;height:46px;min-width:46px;border-radius:13px;font-size:1.3rem}
  .card-title{font-size:.95rem}
  .current-price{font-size:1.1rem}
  .benefits,.reviews,.steps{grid-template-columns:1fr}
  .proof-logos{grid-template-columns:1fr 1fr}
  .footer-grid{grid-template-columns:1fr}
  .footer-grid>div:first-child{grid-column:auto}
  .footer-bottom{flex-direction:column;gap:8px;text-align:center}
}
</style></head><body><main>
<header class="site-header"><div class="shell"><nav class="nav" aria-label="Navigasi utama"><a class="logo" href="/"><img src="/favicon.svg" alt="tokosans logo" class="logo-img" /><span>tokosans<b>.</b></span></a><div class="nav-links"><a href="#produk">Produk</a><a href="#manfaat">Keunggulan</a><a href="#faq">Bantuan</a><a href="/blog">Blog</a><OrderLookupModal client:load /><a class="nav-cta" href="#produk">Belanja sekarang</a></div></nav></div></header>
<section class="hero"><div class="shell"><div class="hero-grid"><div><span class="eyebrow"><i class="dot"></i> Akses Premium & Pengiriman Instan</span><h1>Layanan digital<br/><em>tanpa ribet.</em></h1><p class="lead">Dapatkan akses resmi akun aplikasi digital favoritmu untuk produktivitas, desain, dan hiburan. Diproses otomatis realtime, bergaransi penuh, dan kredensial langsung terkirim ke email & layar.</p><div class="actions"><a class="button primary" href="#produk">Lihat koleksi →</a><a class="button secondary" href="#cara-kerja">Cara kerjanya</a></div><div class="trust"><span>✓ Pengiriman Instan</span><span>✓ Garansi Full Duration</span><span>✓ Akun Langsung Aktif</span></div></div><div class="preview-wrapper">
  <!-- Animated Floating Brand Images from /public -->
  <div class="floating-logo floating-logo-canva">
    <img src="/canva.webp" alt="Canva" />
  </div>
  
  <div class="floating-logo floating-logo-netflix">
    <img src="/netflix.webp" alt="Netflix" />
  </div>

  <div class="floating-logo floating-logo-capcut">
    <img src="/capcut.webp" alt="CapCut" />
  </div>

  <div class="floating-logo floating-logo-chatgpt">
    <img src="/chatgpt.webp" alt="ChatGPT" />
  </div>

  <aside class="preview"><div class="preview-head"><span class="preview-status"><i class="dot"></i> Otomatis Realtime</span><span class="preview-title">Akun Langsung Aktif</span></div><div class="payment"><span class="acc-tag">✓ Siap Digunakan</span><h4 class="prod-title">Produk Pro · 1 Bulan</h4><p class="prod-sub">Akses fitur premium lengkap & garansi penuh</p><div class="preview-box">Akun dikirim otomatis & muncul langsung di layar setelah pembayaran.</div></div></aside>
</div></div></div></section>
<section id="produk" class="section"><div class="shell"><div class="section-top"><div><span class="kicker">Koleksi pilihan</span><h2>Temukan yang kamu butuhkan.</h2></div><p class="copy">Pilih layanan favoritmu, lanjutkan ke checkout, dan dapatkan detail akun dalam satu alur cepat.</p></div><div class="category-nav" aria-label="Filter kategori"><button class="category-filter active" type="button" data-category="all">Semua</button>{categories.map((category) => <button class="category-filter" type="button" data-category={category}>{category}</button>)}</div><div class="catalog">{products.map((product) => {
  const origPrice = product.original_price && product.original_price > product.price ? product.original_price : null;
  const discountPct = origPrice ? Math.round(((origPrice - product.price) / origPrice) * 100) : null;
  return (
    <article class="card" data-category={product.category}>
      <a href={`/checkout?product=${product.id}`} class="card-link" aria-label={product.name}>
        <div class="card-header">
          <div class="app-icon">
            {productImages[product.id] ? (
              <img src={productImages[product.id]} alt={product.name} loading="lazy" />
            ) : (
              <span>{product.icon || '⚡'}</span>
            )}
          </div>
          <div class="card-title-group">
            <h3 class="card-title">{product.name}</h3>
            <div class="card-rating">
              <span class="star">★</span>
              <span>{seededRating(product.id)}{soldCounts[product.id] ? ` · Terjual ${formatSold(soldCounts[product.id])}` : ''}</span>
            </div>
          </div>
        </div>
        <div class="card-badges">
