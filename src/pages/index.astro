.footer{padding:64px 0 28px;color:#dcd4f0;background:#180e29}
.footer-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:50px}
.footer .logo{color:#fff}
.footer-copy{max-width:320px;color:#a89bbd;line-height:1.65;font-size:.88rem}
.footer h3{font-size:.98rem;letter-spacing:0;color:#fff}
.footer a{display:block;margin:10px 0;color:#b8accd;text-decoration:none;font-size:.88rem;transition:color .18s}
.footer a:hover{color:#fff}
.footer-bottom{display:flex;justify-content:space-between;margin-top:48px;padding-top:24px;border-top:1px solid rgba(255,255,255,0.12);color:#8d7fa6;font-size:.8rem}

@media(max-width:1024px){.catalog{grid-template-columns:repeat(3,1fr)}}
@media(max-width:800px){
