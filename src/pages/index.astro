.review-tag{display:inline-block;padding:3px 8px;border-radius:6px;background:#ecfdf5;color:#059669;font-size:.72rem;font-weight:700;margin-bottom:12px}
.review blockquote{min-height:55px;margin:0 0 18px;color:#392e4a;line-height:1.6;font-size:.92rem;font-style:normal}
.reviewer{color:var(--muted);font-size:.82rem}
.reviewer b{display:block;color:#180e29}
.faq{max-width:780px;margin:42px auto 0}
.faq details{margin:12px 0;border-radius:14px;background:#fff;border:1px solid #e8e1f2;overflow:hidden}
.faq summary{position:relative;padding:20px 52px 20px 22px;cursor:pointer;font-weight:700;color:#180e29;list-style:none}
.faq summary:after{content:'+';position:absolute;right:22px;color:var(--v);font-size:1.3rem;font-weight:700}
.faq details[open] summary:after{content:'−'}
