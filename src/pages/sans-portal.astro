---
const hasError = Astro.url.searchParams.get('error') === '1';
---
<html lang="id"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Login Admin — TokoSans</title><style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');:root{--ink:#201630;--muted:#776d83;--v:#7048e8;--line:#e8e2f2}*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;background:radial-gradient(circle at 15% 10%,#eee7ff,transparent 30%),#faf9fd;color:var(--ink);font-family:'DM Sans',sans-serif}.box{width:min(420px,calc(100% - 36px));background:#fff;border:1px solid var(--line);border-radius:20px;padding:34px;box-shadow:0 22px 60px #3d1c7012}.logo{display:block;color:var(--ink);font:800 1.5rem 'Plus Jakarta Sans';letter-spacing:-1.5px;text-decoration:none;margin-bottom:42px}.logo b{color:var(--v)}.eyebrow{color:#5e3aca;background:#f1edff;border-radius:99px;padding:7px 10px;font-size:.7rem;font-weight:800;letter-spacing:.08em}.box h1{font:800 2rem 'Plus Jakarta Sans';letter-spacing:-.06em;margin:17px 0 7px}.intro{color:var(--muted);font-size:.88rem;margin:0 0 26px}.error{border:1px solid #f2c9c5;border-radius:99px;background:#fff0ee;color:#b63f39;padding:11px 12px;font-size:.78rem;margin-bottom:15px;text-align:center}.field{display:block;margin:15px 0}.field span{display:block;font-size:.78rem;font-weight:700;margin-bottom:7px}.field input{width:100%;border:1px solid var(--line);border-radius:9px;padding:12px;font:500 .9rem 'DM Sans';color:var(--ink);outline:none}.field input:focus{border-color:var(--v);box-shadow:0 0 0 3px #7048e822}button{width:100%;border:0;border-radius:10px;background:var(--ink);color:white;padding:13px;margin-top:9px;font:700 .85rem 'DM Sans';cursor:pointer}button:hover{background:var(--v)}.back{display:block;text-align:center;color:var(--muted);font-size:.78rem;text-decoration:none;margin-top:20px}
</style></head><body><main class="box"><a class="logo" href="/">tokosans<b>.</b></a><span class="eyebrow">ADMIN PANEL</span><h1>Selamat datang.</h1><p class="intro">Masuk ke portal administrator TokoSans.</p>{hasError && <div class="error">Email atau password salah.</div>}<form action="/api/admin/login" method="post"><label class="field"><span>Email admin</span><input required type="email" name="email" autocomplete="username" autofocus /></label><label class="field"><span>Password</span><input required type="password" name="password" autocomplete="current-password" /></label><button type="submit">Masuk ke dashboard →</button></form><a class="back" href="/">← Kembali ke toko</a></main></body></html>
