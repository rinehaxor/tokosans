---
import { getPublishedPosts, formatBlogDate, estimateReadTime } from '../../lib/blog';
import RecentSalesToast from '../../components/RecentSalesToast.astro';
let posts: Awaited<ReturnType<typeof getPublishedPosts>> = [];
try { posts = await getPublishedPosts(); } catch {}
---
<html lang="id"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Blog tokosans. — Tips, panduan, dan info terbaru seputar layanan digital."/><title>Blog — tokosans.</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');
:root{--ink:#201630;--muted:#746a80;--v:#7048e8;--l:#f0ecff;--line:#e8e2f2;--bg:#fdfcff}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:'DM Sans',sans-serif}
h1,h2,h3{font-family:'Plus Jakarta Sans';letter-spacing:-.05em}
.shell{max-width:1180px;margin:auto;padding:0 28px}
.site-header{position:sticky;top:0;z-index:1000;background:rgba(253,252,255,0.88);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.nav{height:76px;display:flex;align-items:center;justify-content:space-between}
.logo{font:800 1.55rem 'Plus Jakarta Sans';letter-spacing:-1.5px;color:var(--ink);text-decoration:none}.logo b{color:var(--v)}
.nav-links{display:flex;align-items:center;gap:27px}.nav-links a{color:#5f566a;font-size:.9rem;font-weight:700;text-decoration:none}
.nav-cta{padding:11px 16px;background:var(--ink);color:#fff!important;display:inline-flex;align-items:center;border-radius:12px;text-decoration:none;font-weight:700}
.hero-blog{padding:64px 0 40px;text-align:center}.hero-blog h1{font-size:clamp(2.2rem,4vw,3.4rem);margin:0 0 12px}
.hero-blog p{color:var(--muted);font-size:1.05rem;max-width:560px;margin:0 auto}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:24px;padding:0 0 80px}
.post-card{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden;text-decoration:none;color:var(--ink);transition:all .2s;display:flex;flex-direction:column}
.post-card:hover{transform:translateY(-4px);box-shadow:0 12px 40px rgba(112,72,232,.1);border-color:#d4c8f5}
.post-cover{width:100%;height:200px;object-fit:cover;background:#f0ecff}
.post-body{padding:24px;flex:1;display:flex;flex-direction:column}
.post-body h2{font-size:1.2rem;margin:0 0 8px;line-height:1.35;letter-spacing:-.02em}
.post-body p{color:var(--muted);font-size:.88rem;line-height:1.6;margin:0 0 16px;flex:1}
.post-meta{display:flex;align-items:center;gap:12px;font-size:.78rem;color:var(--muted);font-weight:600}
.post-meta span{display:flex;align-items:center;gap:4px}
.empty-blog{text-align:center;padding:80px 20px;color:var(--muted)}.empty-blog h2{color:var(--ink);margin:0 0 8px}.empty-blog p{margin:0}
.footer{padding:40px 0;text-align:center;color:var(--muted);font-size:.85rem;border-top:1px solid var(--line)}
@media(max-width:600px){.grid{grid-template-columns:1fr}.nav-links{gap:16px}}
</style></head><body>
<header class="site-header"><div class="shell"><nav class="nav"><a class="logo" href="/">tokosans<b>.</b></a><div class="nav-links"><a href="/#produk">Produk</a><a href="/blog" style="color:var(--v)">Blog</a><a href="/#faq">FAQ</a><a class="nav-cta" href="/#produk">Belanja</a></div></nav></div></header>
<div class="shell"><div class="hero-blog"><h1>Blog</h1><p>Tips, panduan, dan info terbaru seputar layanan digital premium.</p></div>
{posts.length === 0 ? (
<div class="empty-blog"><h2>Belum ada artikel</h2><p>Nantikan konten menarik dari kami segera.</p></div>
) : (
<div class="grid">{posts.map((post) => (
<a href={`/blog/${post.slug}`} class="post-card">
{post.cover_url && <img class="post-cover" src={post.cover_url} alt={post.title} loading="lazy"/>}
<div class="post-body">
<h2>{post.title}</h2>
<p>{post.excerpt || post.content.replace(/<[^>]*>/g,'').substring(0,150) + '...'}</p>
<div class="post-meta"><span>{formatBlogDate(post.published_at!)}</span><span>·</span><span>{estimateReadTime(post.content)} mnt baca</span></div>
</div>
</a>
))}</div>
)}
</div>
<footer class="footer"><div class="shell">© 2026 tokosans. Seluruh hak cipta dilindungi.</div></footer>
<RecentSalesToast />
</body></html>
