---
import { getPublishedPosts, formatBlogDate, estimateReadTime } from '../../lib/blog';
import { getSiteUrl } from '../../lib/site';
import RecentSalesToast from '../../components/RecentSalesToast.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const siteUrl = getSiteUrl(Astro.url.origin);
const pageUrl = `${siteUrl}/blog`;

let posts: Awaited<ReturnType<typeof getPublishedPosts>> = [];
try { posts = await getPublishedPosts(); } catch {}

const categories = Array.from(new Set(posts.map(p => p.category || 'Umum')));

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': siteUrl },
    { '@type': 'ListItem', 'position': 2, 'name': 'Blog', 'item': pageUrl }
  ]
};

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  'name': 'Blog tokosans.',
  'description': 'Tips, panduan, tutorial, dan info terbaru seputar layanan digital & akun premium.',
  'url': pageUrl,
  'publisher': {
    '@type': 'Organization',
    'name': 'tokosans.',
    'url': siteUrl,
    'logo': `${siteUrl}/favicon.svg`
  }
};
---
<html lang="id">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="theme-color" content="#7048e8"/>
  <title>Blog — Tips, Panduan & Edukasi Layanan Digital | tokosans.</title>
  <meta name="description" content="Kumpulan panduan, tutorial, tips hemat, dan info terbaru seputar layanan digital premium dari tokosans."/>
  <link rel="canonical" href={pageUrl}/>
  <link rel="manifest" href="/manifest.webmanifest"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>

  <!-- Open Graph -->
  <meta property="og:type" content="website"/>
  <meta property="og:url" content={pageUrl}/>
  <meta property="og:title" content="Blog — Tips, Panduan & Edukasi Layanan Digital | tokosans."/>
  <meta property="og:description" content="Kumpulan panduan, tutorial, tips hemat, dan info terbaru seputar layanan digital premium dari tokosans."/>
  <meta property="og:image" content={`${siteUrl}/og-image.png`}/>
  <meta property="og:site_name" content="tokosans."/>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content="Blog — Tips & Panduan Layanan Digital | tokosans."/>
  <meta name="twitter:description" content="Kumpulan panduan, tutorial, tips hemat, dan info terbaru seputar layanan digital premium dari tokosans."/>
  <meta name="twitter:image" content={`${siteUrl}/og-image.png`}/>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png"/>
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png"/>
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png"/>

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');
:root{--ink:#201630;--muted:#746a80;--v:#7048e8;--l:#f0ecff;--line:#e8e2f2;--bg:#fdfcff}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:'DM Sans',sans-serif}
h1,h2,h3{font-family:'Plus Jakarta Sans';letter-spacing:-.05em}
.shell{max-width:1180px;margin:auto;padding:0 28px}
.hero-blog{padding:64px 0 24px;text-align:center}.hero-blog h1{font-size:clamp(2.2rem,4vw,3.4rem);margin:0 0 12px}
.hero-blog p{color:var(--muted);font-size:1.05rem;max-width:560px;margin:0 auto}
.cat-filters{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;margin:24px 0 40px}
.cat-btn{padding:8px 18px;border-radius:99px;border:1px solid var(--line);background:#fff;color:var(--muted);font-size:.85rem;font-weight:700;cursor:pointer;transition:all .15s}
.cat-btn:hover{background:var(--l);color:var(--v);border-color:#d4c8f5}
.cat-btn.active{background:var(--v);color:#fff;border-color:var(--v);box-shadow:0 4px 14px rgba(112,72,232,.2)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:24px;padding:0 0 80px}
.post-card{background:#fff;border:1px solid var(--line);border-radius:20px;overflow:hidden;text-decoration:none;color:var(--ink);transition:all .2s;display:flex;flex-direction:column}
.post-card:hover{transform:translateY(-4px);box-shadow:0 12px 40px rgba(112,72,232,.1);border-color:#d4c8f5}
.post-cover{width:100%;height:200px;object-fit:cover;background:#f0ecff}
.post-body{padding:24px;flex:1;display:flex;flex-direction:column}
.post-badge{display:inline-block;align-self:flex-start;padding:3px 10px;background:var(--l);color:var(--v);border-radius:99px;font-size:.74rem;font-weight:700;margin-bottom:10px}
.post-body h2{font-size:1.2rem;margin:0 0 8px;line-height:1.35;letter-spacing:-.02em}
.post-body p{color:var(--muted);font-size:.88rem;line-height:1.6;margin:0 0 16px;flex:1}
.post-meta{display:flex;align-items:center;gap:12px;font-size:.78rem;color:var(--muted);font-weight:600}
.post-meta span{display:flex;align-items:center;gap:4px}
.empty-blog{text-align:center;padding:80px 20px;color:var(--muted)}.empty-blog h2{color:var(--ink);margin:0 0 8px}.empty-blog p{margin:0}
@media(max-width:600px){.grid{grid-template-columns:1fr}}
</style></head><body>
<Header activeNav="blog" />
<div class="shell"><div class="hero-blog"><h1>Blog</h1><p>Tips, panduan, dan info terbaru seputar layanan digital premium.</p></div>

{categories.length > 0 && (
  <div class="cat-filters" id="cat-filters">
    <button class="cat-btn active" data-cat="all">Semua</button>
    {categories.map((c) => (
      <button class="cat-btn" data-cat={c}>{c}</button>
    ))}
  </div>
)}

{posts.length === 0 ? (
<div class="empty-blog"><h2>Belum ada artikel</h2><p>Nantikan konten menarik dari kami segera.</p></div>
) : (
<div class="grid" id="posts-grid">{posts.map((post) => (
<a href={`/blog/${post.slug}`} class="post-card" data-category={post.category || 'Umum'}>
{post.cover_url && <img class="post-cover" src={post.cover_url} alt={post.title} loading="lazy"/>}
<div class="post-body">
<span class="post-badge">{post.category || 'Umum'}</span>
<h2>{post.title}</h2>
<p>{post.excerpt || post.content.replace(/<[^>]*>/g,'').substring(0,150) + '...'}</p>
<div class="post-meta"><span>{formatBlogDate(post.published_at!)}</span><span>·</span><span>{estimateReadTime(post.content)} mnt baca</span></div>
</div>
</a>
))}</div>
)}
</div>
<Footer />
<RecentSalesToast />
<script>
  const buttons = document.querySelectorAll('#cat-filters .cat-btn');
  const cards = document.querySelectorAll<HTMLElement>('#posts-grid .post-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const selectedCat = btn.getAttribute('data-cat');
      cards.forEach(card => {
        if (selectedCat === 'all' || card.getAttribute('data-category') === selectedCat) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
</body></html>
