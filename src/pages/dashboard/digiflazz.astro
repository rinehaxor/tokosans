---
import AdminSidebar from '../../components/AdminSidebar.astro';
---
<html lang="id">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Produk Digiflazz – Admin</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');
    :root{--ink:#191026;--muted:#6b6178;--v:#7048e8;--v2:#5c35d4;--l:#f3edff;--line:#eae3f5;--bg:#faf8fe;--surface:#fff;--green:#059669;--green-bg:#ecfdf5;--red:#ef4444;--red-bg:#fef2f2;--orange:#d97706;--orange-bg:#fef3c7}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:'DM Sans',sans-serif;-webkit-font-smoothing:antialiased}
    h1,h2,h3{font-family:'Plus Jakarta Sans',sans-serif;letter-spacing:-.03em}
    .layout{display:flex;min-height:100vh}
    .content{flex:1;margin-left:250px;padding:40px 48px 80px;max-width:1100px}
    .page-head{margin-bottom:28px}.page-head h1{margin:0 0 6px;font-size:2rem;font-weight:800}.page-head p{margin:0;color:var(--muted);font-size:.95rem}
    .toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:20px}
    .toolbar select,.toolbar input{border:1px solid var(--line);border-radius:10px;padding:9px 14px;font:500 .88rem 'DM Sans',sans-serif;color:var(--ink);background:var(--surface)}
    .toolbar select:focus,.toolbar input:focus{outline:2px solid var(--v);border-color:transparent}
    .btn{display:inline-flex;align-items:center;gap:7px;padding:10px 20px;border:0;border-radius:10px;font:700 .88rem 'DM Sans',sans-serif;cursor:pointer;transition:all .15s}
    .btn-primary{background:var(--v);color:#fff}.btn-primary:hover{background:var(--v2);transform:translateY(-1px)}.btn-primary:disabled{opacity:.55;cursor:not-allowed;transform:none}
    .btn-primary.spinning svg{animation:spin .7s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}
    .badge{display:inline-flex;align-items:center;padding:3px 9px;border-radius:99px;font-size:.75rem;font-weight:700}
    .badge-ok{background:var(--green-bg);color:var(--green)}
    .badge-off{background:var(--red-bg);color:var(--red)}
    .stats{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:20px}
    .stat-box{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 22px;min-width:130px}
    .stat-box .num{font:800 1.6rem 'Plus Jakarta Sans',sans-serif;letter-spacing:-.04em}
    .stat-box .lbl{color:var(--muted);font-size:.78rem;margin-top:2px}
    .card{background:var(--surface);border:1px solid var(--line);border-radius:16px;overflow:hidden;margin-bottom:24px}
    table{width:100%;border-collapse:collapse;font-size:.84rem}
    thead th{background:#f8f5ff;padding:11px 14px;text-align:left;font-weight:700;font-size:.78rem;color:var(--muted);border-bottom:1px solid var(--line);white-space:nowrap}
    tbody td{padding:11px 14px;border-bottom:1px solid var(--line);vertical-align:middle}
    tbody tr:last-child td{border-bottom:none}
    tbody tr:hover{background:#faf8ff}
    .sku{font-family:monospace;background:var(--l);color:var(--v);padding:2px 7px;border-radius:6px;font-size:.8rem;font-weight:700}
    .price{font-weight:700;color:var(--ink)}
    .empty{text-align:center;padding:48px 20px;color:var(--muted)}
    .search-wrap{position:relative;flex:1;min-width:200px}
    .search-wrap input{width:100%;padding-left:36px}
    .search-wrap svg{position:absolute;left:11px;top:50%;transform:translateY(-50%);opacity:.4;pointer-events:none}
    .tab-row{display:flex;gap:0;border-bottom:1px solid var(--line);margin-bottom:20px}
    .tab{padding:10px 22px;font:700 .88rem 'DM Sans',sans-serif;cursor:pointer;border:none;background:none;color:var(--muted);border-bottom:2px solid transparent;transition:all .15s;margin-bottom:-1px}
    .tab.active{color:var(--v);border-bottom-color:var(--v)}.tab:hover{color:var(--v)}
    .btn-catalog{display:inline-flex;align-items:center;gap:4px;padding:6px 12px;border-radius:8px;background:var(--l);color:var(--v);font:700 .78rem 'DM Sans',sans-serif;text-decoration:none;white-space:nowrap;transition:all .15s}
    .btn-catalog:hover{background:var(--v);color:#fff;transform:translateY(-1px)}
    .howto{display:flex;gap:12px;align-items:flex-start;background:#f6f2ff;border:1px solid #e4d9fb;border-radius:14px;padding:14px 18px;margin-bottom:20px;color:#5b5170;font-size:.84rem;line-height:1.55}
    .howto b{color:var(--ink)}
    .howto ol{margin:4px 0 0;padding-left:18px;display:grid;gap:2px}
    .howto .howto-ico{flex-shrink:0;width:34px;height:34px;border-radius:10px;background:var(--v);color:#fff;display:grid;place-items:center;font-size:1rem}
    .cache-info{margin-left:auto;font-size:.78rem;color:var(--muted)}
    .cache-info a{color:var(--v);font-weight:600;text-decoration:none}
    .cache-info a:hover{text-decoration:underline}
    @media(max-width:900px){.content{margin-left:0;padding:24px 16px}}
  </style>
</head>
<body>
<div class="layout">
  <AdminSidebar active="digiflazz" />
  <main class="content">
    <div class="page-head">
      <h1>Produk Digiflazz</h1>
      <p>Daftar harga produk prepaid &amp; pascabayar dari Digiflazz</p>
    </div>

    <div class="howto">
      <div class="howto-ico">🎮</div>
      <div><b>Cara menambah produk top up Digiflazz ke katalog toko:</b>
        <ol><li>Klik <b>Muat Data</b>, lalu cari produk (mis. Diamond Mobile Legends).</li><li>Klik tombol <b>＋ Katalog</b> pada baris produk.</li><li>Form produk terbuka dengan SKU, nama, brand & harga terisi otomatis — atur harga jual, lalu <b>Simpan Produk</b>.</li></ol>
      </div>
    </div>

    <div class="tab-row">
      <button class="tab active" id="tab-prepaid" type="button">Prepaid</button>
      <button class="tab" id="tab-pasca" type="button">Pascabayar</button>
    </div>

    <div class="toolbar">
      <div class="search-wrap">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input type="text" id="q-search" placeholder="Cari nama / SKU / brand..." />
      </div>
      <select id="q-category"><option value="">Semua Kategori</option></select>
      <select id="q-brand"><option value="">Semua Brand</option></select>
      <select id="q-status">
        <option value="">Semua Status</option>
        <option value="active">Aktif (buyer &amp; seller)</option>
        <option value="inactive">Ada yang nonaktif</option>
      </select>
      <button class="btn btn-primary" id="btn-load" type="button">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>
        <span id="btn-label">Muat Data</span>
      </button>
      <span class="cache-info" id="cache-info" hidden></span>
    </div>

    <div class="stats" id="stats-row" style="display:none">
      <div class="stat-box"><div class="num" id="st-total">0</div><div class="lbl">Total Produk</div></div>
      <div class="stat-box"><div class="num" id="st-active" style="color:var(--green)">0</div><div class="lbl">Aktif</div></div>
      <div class="stat-box"><div class="num" id="st-inactive" style="color:var(--red)">0</div><div class="lbl">Nonaktif</div></div>
      <div class="stat-box"><div class="num" id="st-categories">0</div><div class="lbl">Kategori</div></div>
    </div>

    <div class="card">
      <div id="table-wrap">
        <div class="empty">
          <p style="margin:0">Klik <strong>Muat Data</strong> untuk mengambil daftar produk dari Digiflazz.</p>
        </div>
      </div>
    </div>
  </main>
</div>
<script>
type Product = {
  product_name: string; category: string; brand: string; type?: string;
  price?: number; admin?: number; commission?: number; buyer_sku_code: string;
  buyer_product_status: boolean; seller_product_status: boolean;
  unlimited_stock?: boolean; stock?: number; desc: string;
};
let allProducts: Product[] = [];
let currentCmd: 'prepaid' | 'pasca' = 'prepaid';
// Cache sesi browser: hindari hit API (dan API Digiflazz) setiap ganti tab / klik ulang.
const sessionCache: Record<string, Product[]> = {};
const btnLoad=document.getElementById('btn-load') as HTMLButtonElement;
const tableWrap=document.getElementById('table-wrap')!;
const statsRow=document.getElementById('stats-row') as HTMLElement;
const qSearch=document.getElementById('q-search') as HTMLInputElement;
const qCategory=document.getElementById('q-category') as HTMLSelectElement;
const qBrand=document.getElementById('q-brand') as HTMLSelectElement;
const qStatus=document.getElementById('q-status') as HTMLSelectElement;
const tabPrepaid=document.getElementById('tab-prepaid') as HTMLButtonElement;
const tabPasca=document.getElementById('tab-pasca') as HTMLButtonElement;
function fmt(n?: number){return n==null?'-':'Rp '+n.toLocaleString('id-ID');}
function catalogUrl(p:Product){const slug=String(p.product_name).toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,60)||p.buyer_sku_code.toLowerCase();return `/dashboard/products/new?sku=${encodeURIComponent(p.buyer_sku_code)}&name=${encodeURIComponent(p.product_name)}&brand=${encodeURIComponent(p.brand||'')}&price=${p.price??''}&cmd=${currentCmd}&id=${encodeURIComponent(slug)}`;}
function populateFilters(products: Product[]){
  const cats=[...new Set(products.map(p=>p.category))].sort();
  const brands=[...new Set(products.map(p=>p.brand))].sort();
  const cv=qCategory.value,bv=qBrand.value;
  qCategory.innerHTML='<option value="">Semua Kategori</option>'+cats.map(c=>`<option value="${c}">${c}</option>`).join('');
  qBrand.innerHTML='<option value="">Semua Brand</option>'+brands.map(b=>`<option value="${b}">${b}</option>`).join('');
  if(cats.includes(cv))qCategory.value=cv;
  if(brands.includes(bv))qBrand.value=bv;
}
function renderTable(products: Product[]){
  const q=qSearch.value.toLowerCase(),cat=qCategory.value,brand=qBrand.value,status=qStatus.value;
  const filtered=products.filter(p=>{
    if(q&&!p.product_name.toLowerCase().includes(q)&&!p.buyer_sku_code.toLowerCase().includes(q)&&!p.brand.toLowerCase().includes(q))return false;
    if(cat&&p.category!==cat)return false;
    if(brand&&p.brand!==brand)return false;
    if(status==='active'&&!(p.buyer_product_status&&p.seller_product_status))return false;
    if(status==='inactive'&&(p.buyer_product_status&&p.seller_product_status))return false;
    return true;
  });
  const active=filtered.filter(p=>p.buyer_product_status&&p.seller_product_status).length;
  document.getElementById('st-total')!.textContent=filtered.length.toLocaleString('id-ID');
  document.getElementById('st-active')!.textContent=active.toLocaleString('id-ID');
  document.getElementById('st-inactive')!.textContent=(filtered.length-active).toLocaleString('id-ID');
  document.getElementById('st-categories')!.textContent=new Set(filtered.map(p=>p.category)).size.toString();
  statsRow.style.display='flex';
  if(!filtered.length){tableWrap.innerHTML='<div class="empty"><p style="margin:0">Tidak ada produk yang cocok dengan filter.</p></div>';return;}
  const ip=currentCmd==='prepaid';
  const rows=filtered.map(p=>{
    const bb=p.buyer_product_status?'<span class="badge badge-ok">Buyer ✓</span>':'<span class="badge badge-off">Buyer ✗</span>';
    const sb=p.seller_product_status?'<span class="badge badge-ok">Seller ✓</span>':'<span class="badge badge-off">Seller ✗</span>';
    const st=p.unlimited_stock?'∞':(p.stock??0).toLocaleString('id-ID');
    const pc=ip?`<td class="price">${fmt(p.price)}</td><td>${st}</td>`:`<td class="price">${fmt(p.admin)}</td><td class="price" style="color:var(--green)">${fmt(p.commission)}</td>`;
    return `<tr><td><span class="sku">${p.buyer_sku_code}</span></td><td>${p.product_name}</td><td>${p.category}</td><td>${p.brand}</td>${pc}<td style="white-space:nowrap">${bb} ${sb}</td>${ip?`<td><a class="btn-catalog" href="${catalogUrl(p)}">＋ Katalog</a></td>`:''}</tr>`;
  }).join('');
  const eh=(ip?'<th>Harga</th><th>Stok</th>':'<th>Admin</th><th>Komisi</th>')+(ip?'<th>Aksi</th>':'');
  tableWrap.innerHTML=`<table><thead><tr><th>SKU</th><th>Nama Produk</th><th>Kategori</th><th>Brand</th>${eh}<th>Status</th></tr></thead><tbody>${rows}</tbody></table>`;
}

function setBtnLabel(txt:string){const l=document.getElementById('btn-label');if(l)l.textContent=txt;}
function setCacheInfo(html:string){const el=document.getElementById('cache-info');if(!el)return;if(html){el.innerHTML=html;el.hidden=false;}else{el.hidden=true;}}

async function loadProducts(force=false){
  // Sudah ada data sesi & bukan refresh paksa -> render ulang saja (tanpa network)
  if(!force&&sessionCache[currentCmd]){allProducts=sessionCache[currentCmd];populateFilters(allProducts);renderTable(allProducts);return;}
  btnLoad.disabled=true;btnLoad.classList.add('spinning');
  setBtnLabel('Memuat...');
  tableWrap.innerHTML='<div class="empty"><p style="margin:0">Mengambil data dari Digiflazz...</p></div>';
  statsRow.style.display='none';
  try{
    const res=await fetch(`/api/admin/digiflazz/price-list?cmd=${currentCmd}${force?'&force=1':''}`);
    const json=await res.json();
    if(!res.ok)throw new Error(json.error??'Gagal mengambil data.');
    allProducts=json.data as Product[];
    sessionCache[currentCmd]=allProducts;
    populateFilters(allProducts);renderTable(allProducts);
    const m=json.meta;
    if(m?.cached){
      const age=m.ageMinutes>90?`${Math.round(m.ageMinutes/60)} jam`:`${m.ageMinutes} menit`;
      setCacheInfo(`📄 Data dari cache${m.stale?' (basi)':''} • diambil ${m.ageMinutes<=0?'baru saja':age} lalu • <a href="#" id="lnk-refresh">Tarik baru dari Digiflazz</a>`);
    }else{
      setCacheInfo(`✅ Data langsung dari Digiflazz (${(m?.total??allProducts.length).toLocaleString('id-ID')} produk) • cache 6 jam`);
    }
    document.getElementById('lnk-refresh')?.addEventListener('click',(ev)=>{ev.preventDefault();loadProducts(true);});
  }catch(e:any){
    tableWrap.innerHTML=`<div class="empty"><p style="margin:0;color:var(--red)">⚠ ${e.message}</p></div>`;
  }finally{
    btnLoad.disabled=false;btnLoad.classList.remove('spinning');
    setBtnLabel('Muat Data');
  }
}
function resetTable(){
  // Ganti tab: pakai cache sesi bila ada, jangan reset ke kosong & jangan hit API
  if(sessionCache[currentCmd]){allProducts=sessionCache[currentCmd];populateFilters(allProducts);renderTable(allProducts);return;}
  allProducts=[];statsRow.style.display='none';setCacheInfo('');
  tableWrap.innerHTML='<div class="empty"><p style="margin:0">Klik <strong>Muat Data</strong> untuk mengambil daftar produk dari Digiflazz.</p></div>';
}
tabPrepaid.addEventListener('click',()=>{currentCmd='prepaid';tabPrepaid.classList.add('active');tabPasca.classList.remove('active');resetTable();});
tabPasca.addEventListener('click',()=>{currentCmd='pasca';tabPasca.classList.add('active');tabPrepaid.classList.remove('active');resetTable();});
btnLoad.addEventListener('click',()=>loadProducts(false));
qSearch.addEventListener('input',()=>renderTable(allProducts));
qCategory.addEventListener('change',()=>renderTable(allProducts));
qBrand.addEventListener('change',()=>renderTable(allProducts));
qStatus.addEventListener('change',()=>renderTable(allProducts));
</script>
</body>
</html>

