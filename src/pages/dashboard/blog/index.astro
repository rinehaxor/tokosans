---
import { getAllPosts, formatBlogDate } from '../../../lib/blog';
import ToastProvider from '../../../components/ToastProvider';
import AdminSidebar from '../../../components/AdminSidebar.astro';
let posts: Awaited<ReturnType<typeof getAllPosts>> = [];
let error = false;
try { posts = await getAllPosts(); } catch { error = true; }
---
<ToastProvider client:load />
<html lang="id"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>Blog - Admin Dashboard</title>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');
:root{--ink:#191026;--muted:#6b6178;--v:#7048e8;--v2:#5c35d4;--l:#f3edff;--line:#eae3f5;--bg:#faf8fe;--surface:#fff;--green:#059669;--green-bg:#ecfdf5;--red:#ef4444;--red-bg:#fef2f2}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:'DM Sans',sans-serif;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:'Plus Jakarta Sans',sans-serif;letter-spacing:-.03em}
.layout{display:flex;min-height:100vh}.content{flex:1;margin-left:250px;padding:40px 48px 80px;max-width:1100px}
.page-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:32px;gap:20px}
.page-title h1{margin:0 0 6px;font-size:2rem;font-weight:800}.page-title p{margin:0;color:var(--muted);font-size:.95rem}
.btn-primary{display:inline-flex;align-items:center;gap:8px;padding:12px 22px;background:var(--v);color:#fff;font-weight:700;font-size:.9rem;border-radius:12px;text-decoration:none;border:0;cursor:pointer;box-shadow:0 4px 16px rgba(112,72,232,.25);transition:all .15s}
.btn-primary:hover{background:var(--v2);transform:translateY(-1px)}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:20px;box-shadow:0 4px 24px rgba(112,72,232,.04);overflow:hidden}
.bt{width:100%;border-collapse:separate;border-spacing:0;text-align:left;font-size:.9rem}
.bt th{background:#faf8fd;padding:14px 24px;color:var(--muted);font-weight:700;font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid var(--line)}
.bt td{padding:18px 24px;border-bottom:1px solid #f4effa;vertical-align:middle}.bt tr:last-child td{border-bottom:none}.bt tr:hover td{background:#faf8ff}
.sp{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:99px;font-size:.75rem;font-weight:700}
.sp.published{background:var(--green-bg);color:var(--green)}.sp.draft{background:#f1f5f9;color:#64748b}
.be{padding:7px 14px;border-radius:8px;border:1px solid var(--line);background:var(--surface);color:var(--v);font-size:.8rem;font-weight:700;cursor:pointer;text-decoration:none}.be:hover{background:var(--l)}
.bd{padding:7px 14px;border-radius:8px;border:1px solid #fca5a5;background:var(--red-bg);color:var(--red);font-size:.8rem;font-weight:700;cursor:pointer}.bd:hover{background:#fee2e2}.bd:disabled{opacity:.5;cursor:not-allowed}
@media(max-width:900px){.content{margin-left:0;padding:24px 20px}}
</style></head>
<body><div class="layout"><AdminSidebar active="blog" /><main class="content">
<div class="page-head"><div class="page-title"><h1>Blog</h1><p>Kelola artikel dan konten blog</p></div><a href="/dashboard/blog/new" class="btn-primary"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Tulis Artikel</a></div>
{error && <div style="padding:16px;background:#fef2f2;border:1px solid #fca5a5;border-radius:12px;color:#ef4444;font-weight:600;font-size:.9rem;margin-bottom:20px">Gagal memuat data blog. Pastikan tabel blog_posts sudah dibuat.</div>}
{posts.length === 0 && !error ? (
<div class="panel"><div style="text-align:center;padding:60px 20px;color:var(--muted)"><h3 style="margin:0 0 8px;color:var(--ink)">Belum ada artikel</h3><p style="margin:0 0 20px;font-size:.92rem">Mulai menulis artikel pertamamu.</p><a href="/dashboard/blog/new" class="btn-primary">Tulis Artikel Pertama</a></div></div>
) : (
<div class="panel"><div style="width:100%;overflow-x:auto"><table class="bt"><thead><tr><th>Artikel</th><th>Status</th><th>Tanggal</th><th style="width:160px">Aksi</th></tr></thead><tbody id="blog-tbody">
{posts.map((post) => (<tr>
<td><span style="font-weight:700;display:block;margin-bottom:2px">{post.title}</span><span style="font-size:.78rem;color:var(--muted);font-family:monospace">/blog/{post.slug}</span></td>
<td><span class={`sp ${post.status}`}><span style="width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block"></span>{post.status === 'published' ? 'Published' : 'Draft'}</span></td>
<td style="font-size:.85rem;color:var(--muted)">{formatBlogDate(post.published_at || post.created_at)}</td>
<td><div style="display:flex;gap:8px"><a href={`/dashboard/blog/${post.id}`} class="be">Edit</a>{post.status === 'published' && <a href={`/blog/${post.slug}`} class="be" target="_blank">Lihat</a>}<button class="bd" data-delete={post.id} data-title={post.title}>Hapus</button></div></td>
</tr>))}
</tbody></table></div>
<div id="blog-pagination" style="display:flex;align-items:center;justify-content:space-between;padding:14px 24px;border-top:1px solid var(--line);font-size:.84rem;color:var(--muted);background:#fff">
  <span id="blog-page-info">Menampilkan 0 artikel</span>
  <div style="display:flex;gap:8px">
    <button type="button" id="blog-prev-btn" class="be" style="padding:6px 14px">← Prev</button>
    <button type="button" id="blog-next-btn" class="be" style="padding:6px 14px">Next →</button>
  </div>
</div></div>)}
</main></div>
<script>
const notify = (t: string, m: string) => window.dispatchEvent(new CustomEvent('app:toast', { detail: { type: t, message: m } }));
document.querySelectorAll('[data-delete]').forEach((b) => { b.addEventListener('click', async () => {
  const id = (b as HTMLElement).dataset.delete, title = (b as HTMLElement).dataset.title;
  if (!id || !confirm(`Hapus artikel "${title}"?`)) return;
  (b as HTMLButtonElement).disabled = true;
  try { const r = await fetch('/api/admin/blog', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }) }); if (!r.ok) throw new Error((await r.json().catch(()=>({}))).message || 'Gagal.'); notify('success', 'Artikel dihapus.'); setTimeout(() => location.reload(), 600); }
  catch (e) { notify('error', e instanceof Error ? e.message : 'Gagal menghapus.'); (b as HTMLButtonElement).disabled = false; }
}); });

let currentBlogPage = 1;
const blogPerPage = 10;
const blogRows = document.querySelectorAll('#blog-tbody tr');

function renderBlogPagination() {
  const totalVisible = blogRows.length;
  const totalPages = Math.ceil(totalVisible / blogPerPage) || 1;
  if (currentBlogPage > totalPages) currentBlogPage = totalPages;
  if (currentBlogPage < 1) currentBlogPage = 1;

  const startIdx = (currentBlogPage - 1) * blogPerPage;
  const endIdx = startIdx + blogPerPage;

  blogRows.forEach((row, idx) => {
    (row as HTMLElement).style.display = idx >= startIdx && idx < endIdx ? '' : 'none';
  });

  const infoEl = document.getElementById('blog-page-info');
  if (infoEl) {
    if (totalVisible === 0) {
      infoEl.textContent = 'Tidak ada artikel';
    } else {
      infoEl.textContent = `Menampilkan ${startIdx + 1}–${Math.min(endIdx, totalVisible)} dari ${totalVisible} artikel (Hal ${currentBlogPage}/${totalPages})`;
    }
  }

  const prevBtn = document.getElementById('blog-prev-btn') as HTMLButtonElement;
  const nextBtn = document.getElementById('blog-next-btn') as HTMLButtonElement;
  if (prevBtn) {
    prevBtn.disabled = currentBlogPage <= 1;
    prevBtn.style.opacity = currentBlogPage <= 1 ? '0.5' : '1';
    prevBtn.style.cursor = currentBlogPage <= 1 ? 'not-allowed' : 'pointer';
  }
  if (nextBtn) {
    nextBtn.disabled = currentBlogPage >= totalPages;
    nextBtn.style.opacity = currentBlogPage >= totalPages ? '0.5' : '1';
    nextBtn.style.cursor = currentBlogPage >= totalPages ? 'not-allowed' : 'pointer';
  }
}

document.getElementById('blog-prev-btn')?.addEventListener('click', () => {
  if (currentBlogPage > 1) { currentBlogPage--; renderBlogPagination(); }
});
document.getElementById('blog-next-btn')?.addEventListener('click', () => {
  currentBlogPage++; renderBlogPagination();
});
renderBlogPagination();
</script></body></html>

