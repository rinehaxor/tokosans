---
import { getProducts } from '../../../lib/products';
import { getProductPackages } from '../../../lib/packages';
import { getSupabaseAdmin } from '../../../lib/supabase';
import ToastProvider from '../../../components/ToastProvider';
import AccountsTable, { type AccountItem } from '../../../components/AccountsTable';
import AdminSidebar from '../../../components/AdminSidebar.astro';

type Account = { id: string; product_id: string; package_id: string | null; login: string; password: string; status: 'available' | 'sold' | 'disabled'; created_at: string };
let accounts: Account[] = [];
let connected = true;
try {
  const { data, error } = await getSupabaseAdmin().from('account_inventory').select('id,product_id,package_id,login,password,status,created_at').order('created_at', { ascending: false });
  if (error) throw error;
  accounts = (data ?? []) as Account[];
} catch (error) {
  connected = false;
  console.error('Account dashboard error:', error);
}

const managedProducts = await getProducts();
const productName = (id: string) => managedProducts.find((product) => product.id === id)?.name ?? id;

const packageMap: Record<string, { id: string; name: string; duration: string }[]> = {};
for (const product of managedProducts) {
  try {
    packageMap[product.id] = (await getProductPackages(product)).map((item) => ({ id: item.id, name: item.name, duration: item.duration }));
  } catch {
    packageMap[product.id] = [];
  }
}

const packageName = (productId: string, packageId: string | null) => {
  const list = packageMap[productId] ?? [];
  const found = list.find((item) => item.id === packageId);
  if (!found) return 'Default';
  return found.name === found.duration ? found.name : `${found.name} - ${found.duration}`;
};

const accountItems: AccountItem[] = accounts.map((acc) => ({
  ...acc,
  product_name: productName(acc.product_id),
  package_name: packageName(acc.product_id, acc.package_id),
}));

const productOptions = managedProducts.map((p) => ({ id: p.id, name: p.name }));

const available = accounts.filter((account) => account.status === 'available').length;
const sold = accounts.filter((account) => account.status === 'sold').length;
const disabled = accounts.filter((account) => account.status === 'disabled').length;
---
<ToastProvider client:load />
<html lang="id">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Stok Akun - Admin Dashboard - TokoSans</title>
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');
    :root {
      --ink: #191026; --muted: #6b6178; --v: #7048e8; --v2: #5c35d4; --l: #f3edff; --line: #eae3f5; --bg: #faf8fe; --surface: #ffffff;
      --green: #10b981; --green-bg: #ecfdf5; --yellow: #f59e0b; --yellow-bg: #fffbeb; --red: #ef4444; --red-bg: #fef2f2;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--ink); font-family: 'DM Sans', sans-serif; -webkit-font-smoothing: antialiased; }
    h1, h2, h3, h4 { font-family: 'Plus Jakarta Sans', sans-serif; letter-spacing: -.03em; }

    .layout { display: flex; min-height: 100vh; }

    .content { flex: 1; margin-left: 250px; padding: 40px 48px 80px; max-width: 1400px; }
    .page-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 32px; gap: 20px; }
    .page-title h1 { margin: 0 0 6px; font-size: 2rem; font-weight: 800; color: var(--ink); }
    .page-title p { margin: 0; color: var(--muted); font-size: .95rem; }
    .btn-create { display: inline-flex; align-items: center; gap: 8px; background: var(--v); color: #fff; text-decoration: none; padding: 12px 22px; border-radius: 12px; font-weight: 700; font-size: .9rem; box-shadow: 0 4px 14px rgba(112,72,232,.3); transition: all .15s ease; }
    .btn-create:hover { background: var(--v2); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(112,72,232,.4); }

    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 32px; }
    .stat-card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 22px 24px; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 2px 12px rgba(112,72,232,.03); }
    .stat-info label { display: block; color: var(--muted); font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 6px; }
    .stat-info span { display: block; font-size: 1.8rem; font-weight: 800; font-family: 'Plus Jakarta Sans', sans-serif; color: var(--ink); }
    .stat-icon { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; font-size: 1.2rem; }
    .stat-icon.available { background: var(--green-bg); color: var(--green); }
    .stat-icon.sold { background: var(--l); color: var(--v); }
    .stat-icon.disabled { background: var(--red-bg); color: var(--red); }

    /* Table & Components Styles */
    .table-wrapper { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,.02); overflow: hidden; }
    .table-filter-bar { padding: 16px 20px; border-bottom: 1px solid var(--line); background: #fcfbfe; display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; align-items: center; }
    .search-input-wrap { position: relative; flex: 1; min-width: 260px; max-width: 400px; }
    .icon-search { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none; }
    .filter-input { width: 100%; padding: 10px 14px 10px 38px; border: 1px solid var(--line); border-radius: 10px; font-family: inherit; font-size: .88rem; outline: none; background: var(--surface); transition: border-color .15s, box-shadow .15s; }
    .filter-input:focus { border-color: var(--v); box-shadow: 0 0 0 3px rgba(112,72,232,.12); }
    .filter-selects { display: flex; gap: 10px; flex-wrap: wrap; }
    .filter-select { border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px; font-family: inherit; font-size: .85rem; font-weight: 600; color: var(--ink); background: var(--surface); cursor: pointer; outline: none; }
    .filter-select:focus { border-color: var(--v); }

    .table-scroll { width: 100%; overflow-x: auto; }
    .accounts-react-table { width: 100%; border-collapse: separate; border-spacing: 0; text-align: left; font-size: .88rem; }
    .accounts-react-table th { background: #faf8fd; padding: 14px 20px; color: var(--muted); font-weight: 700; font-size: .75rem; text-transform: uppercase; letter-spacing: .06em; border-bottom: 1px solid var(--line); }
    .accounts-react-table td { padding: 16px 20px; border-bottom: 1px solid #f4effa; vertical-align: middle; background: var(--surface); }
    .accounts-react-table tr:last-child td { border-bottom: none; }
    .accounts-react-table tr:hover td { background: #faf8ff; }

    .prod-title { font-weight: 700; color: var(--ink); font-size: .92rem; }
    .pkg-badge { display: inline-flex; align-items: center; gap: 4px; margin-top: 4px; font-size: .78rem; font-weight: 600; color: var(--v); background: var(--l); padding: 2px 8px; border-radius: 6px; }

    .cred-box { background: #faf9fc; border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; max-width: 320px; font-size: .82rem; }
    .cred-line { display: flex; justify-content: space-between; gap: 16px; padding: 3px 0; }
    .cred-line.border-t { border-top: 1px dashed #eae3f5; margin-top: 2px; }
    .cred-key { color: var(--muted); font-weight: 600; }
    .cred-val { font-family: monospace; font-weight: 700; color: var(--ink); word-break: break-all; }

    .status-pill { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 20px; font-size: .78rem; font-weight: 700; }
    .pill-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .status-pill.available { background: var(--green-bg); color: var(--green); }
    .status-pill.sold { background: var(--l); color: var(--v); }
    .status-pill.disabled { background: var(--red-bg); color: var(--red); }

    .actions-flex { display: flex; align-items: center; justify-content: flex-end; gap: 8px; }
    .btn-edit { display: inline-flex; align-items: center; padding: 6px 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--v); font-weight: 700; font-size: .8rem; text-decoration: none; transition: all .15s ease; }
    .btn-edit:hover { background: var(--v); color: #fff; border-color: var(--v); }
    .btn-delete { display: inline-flex; align-items: center; padding: 6px 14px; border: 1px solid #fca5a5; border-radius: 8px; background: #fff5f5; color: var(--red); font-weight: 700; font-size: .8rem; cursor: pointer; transition: all .15s ease; }
    .btn-delete:hover { background: var(--red); color: #fff; }
    .btn-delete:disabled { opacity: .5; cursor: not-allowed; }
    .empty-td { padding: 40px; text-align: center; color: var(--muted); font-size: .9rem; }

    @media (max-width: 900px) {
      .layout { flex-direction: column; }
      .content { margin-left: 0; padding: 24px 16px 40px; }
      .page-head { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
<body>
<div class="layout">
  <AdminSidebar active="accounts" />

  <main class="content">
    <div class="page-head">
      <div class="page-title">
        <h1>Kelola Stok Akun</h1>
        <p>Daftar credential akun digital yang otomatis dikirim setelah pembayaran lunas.</p>
      </div>
      <div style="display: flex; gap: 12px;">
        <a href="/dashboard/accounts/bulk" class="btn-create" style="background: var(--surface); color: var(--v); border: 1px solid var(--v);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Import Bulk
        </a>
        <a href="/dashboard/accounts/new" class="btn-create">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Tambah Akun
        </a>
      </div>
    </div>

    {!connected && (
      <div style="background:#fff1f0;border:1px solid #ffccc7;padding:14px 18px;border-radius:12px;color:#cf1322;margin-bottom:24px;font-size:.9rem;font-weight:600;">
        ⚠️ Koneksi database terganggu. Data di bawah ini mungkin tidak terbaru.
      </div>
    )}

    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-info">
          <label>Akun Tersedia</label>
          <span>{available}</span>
        </div>
        <div class="stat-icon available">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-info">
          <label>Sudah Terjual</label>
          <span>{sold}</span>
        </div>
        <div class="stat-icon sold">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-info">
          <label>Dinonaktifkan</label>
          <span>{disabled}</span>
        </div>
        <div class="stat-icon disabled">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        </div>
      </div>
    </div>

    <AccountsTable client:only="react" accounts={accountItems} products={productOptions} />
  </main>
</div>
</body>
</html>
