          <h3 class="footer-title">Bantuan</h3>
          <ul class="footer-links">
            <li><a href="/#faq">Tanya Jawab (FAQ)</a></li>
            <li><a href="mailto:hello@tokosans.id">hello@tokosans.id</a></li>
            <li><a href="/#produk">Mulai Belanja</a></li>
          </ul>
        </div>

        <!-- Legal Column -->
        <div class="footer-col">
          <h3 class="footer-title">Legalitas</h3>
          <ul class="footer-links">
            <li><a href="/syarat-ketentuan">Syarat &amp; Ketentuan</a></li>
            <li><a href="/kebijakan-privasi">Kebijakan Privasi</a></li>
