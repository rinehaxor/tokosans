<style>
.footer {
  padding: 72px 0 36px;
  background: #180e29;
  color: #fff;
}
.shell {
  max-width: 1180px;
  margin: auto;
  padding: 0 28px;
}
.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font: 800 1.55rem 'Plus Jakarta Sans', sans-serif;
  letter-spacing: -1.5px;
  color: #fff;
  text-decoration: none;
}
.logo b {
  color: #7048e8;
}
.logo-img {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  object-fit: contain;
}
.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 48px;
}
.footer-copy {
  margin: 18px 0 0;
  color: #a395bd;
  line-height: 1.65;
  font-size: .92rem;
  max-width: 340px;
}
.footer h3 {
  font-size: .98rem;
  letter-spacing: 0;
  color: #fff;
  font-family: 'Plus Jakarta Sans', sans-serif;
  margin: 0 0 12px;
}
.footer a {
  display: block;
  margin: 10px 0;
  color: #b8accd;
  text-decoration: none;
  font-size: .88rem;
  transition: color .18s;
}
.footer a:hover {
  color: #fff;
}
.footer-bottom {
  display: flex;
  justify-content: space-between;
  margin-top: 48px;
  padding-top: 24px;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  color: #8d7fa6;
  font-size: .8rem;
}
@media (max-width: 800px) {
  .shell {
    padding: 0 20px;
  }
  .footer-grid {
    grid-template-columns: 1fr 1fr;
  }
  .footer-grid > div:first-child {
    grid-column: 1 / -1;
  }
}
@media (max-width: 640px) {
  .footer-grid {
    grid-template-columns: 1fr;
  }
  .footer-grid > div:first-child {
    grid-column: auto;
  }
  .footer-bottom {
    flex-direction: column;
    gap: 8px;
    text-align: center;
  }
}
</style>
