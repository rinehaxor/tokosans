      </div>

      <!-- Links Wrapper for Responsive Layout -->
      <div class="footer-links-group">
        <!-- Navigation Column -->
        <div class="footer-col">
          <h3 class="footer-title">Jelajahi</h3>
          <ul class="footer-links">
