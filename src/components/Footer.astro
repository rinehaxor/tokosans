</footer>


<style>
  .footer {
    background: #140d22;
    color: #ffffff;
    padding: 64px 0 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    width: 100%;
    box-sizing: border-box;
  }

  .footer-shell {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  .footer-grid {
    display: flex;
    justify-content: space-between;
    gap: 48px;
    align-items: flex-start;
  }

  .footer-brand {
    max-width: 360px;
    flex-shrink: 0;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    user-select: none;
  }

  .footer-logo-img {
    width: 30px;
    height: 30px;
    display: block;
    border-radius: 8px;
    object-fit: contain;
  }

  .footer-logo-text {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -1px;
    color: #ffffff;
    line-height: 1;
  }

  .footer-logo-text b {
    color: #7048e8;
  }

  .footer-copy {
    margin: 14px 0 18px;
    color: #9f91ba;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .footer-badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 6px;
    background: rgba(112, 72, 232, 0.15);
    border: 1px solid rgba(112, 72, 232, 0.28);
    color: #cfc2f0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .footer-links-group {
    display: grid;
    grid-template-columns: repeat(3, minmax(130px, 1fr));
    gap: 36px;
    flex-grow: 1;
    max-width: 650px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-title {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 0.92rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 14px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    color: #aea0c4;
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 500;
    transition: color 0.15s ease, transform 0.15s ease;
    display: inline-block;
    padding: 2px 0;
  }

  .footer-links a:hover {
    color: #ffffff;
    transform: translateX(2px);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 48px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #84759d;
    font-size: 0.8rem;
  }

  @media (max-width: 900px) {
    .footer {
      padding: 52px 0 28px;
    }
    .footer-grid {
      flex-direction: column;
      gap: 36px;
    }
    .footer-brand {
      max-width: 100%;
    }
    .footer-links-group {
      width: 100%;
      max-width: 100%;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 600px) {
    .footer-shell {
      padding: 0 18px;
    }
    .footer-links-group {
      grid-template-columns: repeat(2, 1fr);
      gap: 28px 16px;
    }
    .footer-links-group .footer-col:last-child {
      grid-column: 1 / -1;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      margin-top: 36px;
    }
  }

  @media (max-width: 380px) {
    .footer-links-group {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .footer-links-group .footer-col:last-child {
      grid-column: auto;
    }
  }
</style>
