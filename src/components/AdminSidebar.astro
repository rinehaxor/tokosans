---
interface Props {
  active: 'dashboard' | 'accounts' | 'categories' | 'blog' | 'tools';
}

const { active } = Astro.props;
---

<aside class="sidebar">
  <div class="sidebar-head">
    <a href="/" class="logo">tokosans<b>.</b></a>
  </div>
  <nav class="nav">
    <a href="/dashboard" class={active === 'dashboard' ? 'active' : ''}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
      Dashboard
    </a>
    <a href="/dashboard/accounts" class={active === 'accounts' ? 'active' : ''}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 2-2 2m-1-1 4 4m-4 0 2 2m-11 8 6-6 3 3-6 6h-3v-3z"/></svg>
      Stok Akun
    </a>
    <a href="/dashboard/categories" class={active === 'categories' ? 'active' : ''}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
      Kategori
    </a>
    <a href="/dashboard/blog" class={active === 'blog' ? 'active' : ''}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
      Blog
    </a>
    <a href="/dashboard/tools" class={active === 'tools' ? 'active' : ''}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
      Tools
    </a>
    <a href="/#produk" target="_blank">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      Lihat Toko
    </a>
  </nav>
  <div class="sidebar-footer">
    <a href="/api/admin/logout" class="logout-btn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      Keluar
    </a>
  </div>
</aside>

<style>
  .sidebar { width: 250px; background: var(--surface, #ffffff); border-right: 1px solid var(--line, #eae3f5); display: flex; flex-direction: column; position: fixed; inset: 0 auto 0 0; z-index: 10; }
  .sidebar-head { padding: 28px 24px; }
  .logo { font: 800 1.6rem 'Plus Jakarta Sans', sans-serif; letter-spacing: -1.5px; color: var(--ink, #191026); text-decoration: none; display: inline-block; }
  .logo b { color: var(--v, #7048e8); }
  .nav { display: flex; flex-direction: column; gap: 4px; padding: 0 16px; }
  .nav a { display: flex; align-items: center; gap: 12px; padding: 11px 14px; color: var(--muted, #6b6178); text-decoration: none; font-weight: 700; font-size: .88rem; border-radius: 10px; transition: all .15s ease; }
  .nav a:hover, .nav a.active { color: var(--v, #7048e8); background: var(--l, #f3edff); }
  .sidebar-footer { margin-top: auto; padding: 20px 16px; border-top: 1px solid var(--line, #eae3f5); }
  .logout-btn { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 11px; color: #716280; border: 1px solid var(--line, #eae3f5); border-radius: 10px; text-decoration: none; font-size: .85rem; font-weight: 700; background: var(--surface, #ffffff); transition: all .15s ease; }
  .logout-btn:hover { background: #fdf2f2; color: var(--red, #ef4444); border-color: #fca5a5; }

  @media (max-width: 900px) {
    .sidebar { position: static; width: 100%; height: auto; }
  }
</style>